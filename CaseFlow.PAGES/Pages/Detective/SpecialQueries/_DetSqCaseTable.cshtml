@model List<CaseFlow.BLL.Dto.Case.CaseDto>
@if (Model == null || Model.Count == 0)
{
    <p class="text-muted small mb-0">Нічого не знайдено.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered table-hover">
            <thead>
            <tr>
                <th>ID</th>
                <th>Назва</th>
                <th>Клієнт</th>
                <th>Тип</th>
                <th>Початок</th>
                <th>Дедлайн</th>
                <th>Статус</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr class="clickable-row" data-href="@Url.Page("/Detective/Cases/Details", new { id = c.Id })">
                    <td>@c.Id</td>
                    <td>@c.Title</td>
                    <td>@c.ClientFullName</td>
                    <td>@c.CaseTypeName</td>
                    <td>@c.StartDate</td>
                    <td>@c.DeadlineDate</td>
                    <td>@UkLabels.CaseStatusLabel(c.Status)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
