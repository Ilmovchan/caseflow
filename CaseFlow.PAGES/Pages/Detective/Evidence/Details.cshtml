@page "{id:int}"
@model CaseFlow.PAGES.Pages.Detective.Evidence.DetailsModel
@{
    ViewData["Title"] = "Деталі доказу";
}

<h2>Деталі доказу</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Evidence.EvidenceId</dd>
    <dt class="col-sm-2">ID справи</dt>
    <dd class="col-sm-10">@(Model.Evidence.CaseId?.ToString() ?? "—")</dd>
    <dt class="col-sm-2">Тип</dt>
    <dd class="col-sm-10">@Model.Evidence.Type</dd>
    <dt class="col-sm-2">Опис</dt>
    <dd class="col-sm-10">@Model.Evidence.Description</dd>
    <dt class="col-sm-2">Дата збору</dt>
    <dd class="col-sm-10">@Model.Evidence.CollectionDate</dd>
    <dt class="col-sm-2">Регіон</dt>
    <dd class="col-sm-10">@Model.Evidence.Region</dd>
    <dt class="col-sm-2">Мета</dt>
    <dd class="col-sm-10">@(Model.Evidence.Purpose ?? "-")</dd>
    <dt class="col-sm-2">Примітки</dt>
    <dd class="col-sm-10">@(Model.Evidence.Annotation ?? "-")</dd>
</dl>

<a asp-page="Index" class="btn btn-secondary">Назад</a>

