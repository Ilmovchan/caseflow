@page "{id:int}"
@model CaseFlow.PAGES.Pages.Detective.Evidence.DetailsModel
@using CaseFlow.DAL.Enums
@{
    ViewData["Title"] = "Деталі доказу";
    var evSt = Model.Evidence.ApprovalStatus;
}

<h2>Деталі доказу</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Evidence.EvidenceId</dd>
    <dt class="col-sm-2">Справа</dt>
    <dd class="col-sm-10">
        @if (Model.Evidence.CaseId is int cid)
        {
            <a asp-page="/Detective/Cases/Details" asp-route-id="@cid">#@cid</a>
        }
        else
        {
            <span>—</span>
        }
    </dd>
    <dt class="col-sm-2">Тип</dt>
    <dd class="col-sm-10">@UkLabels.EvidenceTypeLabel(Model.Evidence.Type)</dd>
    <dt class="col-sm-2">Опис</dt>
    <dd class="col-sm-10">@Model.Evidence.Description</dd>
    <dt class="col-sm-2">Дата збору</dt>
    <dd class="col-sm-10">@Model.Evidence.CollectionDate</dd>
    <dt class="col-sm-2">Регіон</dt>
    <dd class="col-sm-10">@Model.Evidence.Region</dd>
    <dt class="col-sm-2">Мета</dt>
    <dd class="col-sm-10">@(Model.Evidence.Purpose ?? "-")</dd>
    <dt class="col-sm-2">Примітки</dt>
    <dd class="col-sm-10">@(Model.Evidence.Annotation ?? "-")</dd>
    <dt class="col-sm-2">Статус</dt>
    <dd class="col-sm-10">
        <span class="badge bg-@(evSt.ToString() == "Approved" ? "success" : evSt.ToString() == "Pending" ? "warning" : evSt.ToString() == "Declined" ? "danger" : "secondary")">
            @UkLabels.ApprovalStatusLabel(evSt)
        </span>
    </dd>
</dl>

@if (evSt is ApprovalStatus.Draft or ApprovalStatus.Declined)
{
    <a asp-page="Edit" asp-route-id="@Model.Evidence.EvidenceId" class="btn btn-primary">Редагувати</a>
}
<a asp-page="Index" class="btn btn-secondary">Назад</a>

