@page
@model CaseFlow.PAGES.Pages.Detective.Expenses.CreateModel
@{
    ViewData["Title"] = "Подати видатки";
}

<h2>Подати видатки</h2>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @foreach (var modelState in ViewData.ModelState.Values)
        {
            @foreach (var error in modelState.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post">
    <div class="row">
        <div class="col-md-8">
            <div class="mb-3">
                <label asp-for="Input.CaseId" class="form-label"></label>
                <select asp-for="Input.CaseId" class="form-control" required>
                    <option value="">-- Виберіть справу --</option>
                    @foreach (var caseItem in Model.Cases)
                    {
                        <option value="@caseItem.Id">@caseItem.Title (ID: @caseItem.Id)</option>
                    }
                </select>
                <span asp-validation-for="Input.CaseId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Purpose" class="form-label"></label>
                <input asp-for="Input.Purpose" class="form-control" required />
                <small class="form-text text-muted">Опишіть мету видатків</small>
                <span asp-validation-for="Input.Purpose" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Amount" class="form-label"></label>
                <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" required />
                <small class="form-text text-muted">Сума в гривнях</small>
                <span asp-validation-for="Input.Amount" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.DateTime" class="form-label"></label>
                <input asp-for="Input.DateTime" class="form-control" type="datetime-local" required />
                <span asp-validation-for="Input.DateTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Annotation" class="form-label"></label>
                <textarea asp-for="Input.Annotation" class="form-control" rows="3"></textarea>
                <small class="form-text text-muted">Додаткові примітки (необов'язково)</small>
                <span asp-validation-for="Input.Annotation" class="text-danger"></span>
            </div>
        </div>
    </div>
    <button type="submit" asp-page-handler="Submit" class="btn btn-primary">Подати на розгляд</button>
    <button type="submit" asp-page-handler="Draft" class="btn btn-outline-secondary">Зберегти чернетку</button>
    <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
</form>

<partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />

