@page "{id:int}"
@model CaseFlow.PAGES.Pages.Detective.Expenses.DetailsModel
@using CaseFlow.DAL.Enums
@{
    ViewData["Title"] = "Деталі видатків";
}

<h2>Деталі видатків</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Expense.Id</dd>
    <dt class="col-sm-2">Справа</dt>
    <dd class="col-sm-10"><a asp-page="/Detective/Cases/Details" asp-route-id="@Model.Expense.CaseId">#@Model.Expense.CaseId</a></dd>
    <dt class="col-sm-2">Мета</dt>
    <dd class="col-sm-10">@Model.Expense.Purpose</dd>
    <dt class="col-sm-2">Сума</dt>
    <dd class="col-sm-10">@Model.Expense.Amount.ToString("C")</dd>
    <dt class="col-sm-2">Дата</dt>
    <dd class="col-sm-10">@Model.Expense.DateTime</dd>
    <dt class="col-sm-2">Статус</dt>
    <dd class="col-sm-10">
        @{
            var expSt = Model.Expense.ApprovalStatus ?? CaseFlow.DAL.Enums.ApprovalStatus.Draft;
        }
        <span class="badge bg-@(expSt.ToString() == "Approved" ? "success" : expSt.ToString() == "Pending" ? "warning" : expSt.ToString() == "Declined" ? "danger" : "secondary")">
            @UkLabels.ApprovalStatusLabel(expSt)
        </span>
    </dd>
    <dt class="col-sm-2">Примітки</dt>
    <dd class="col-sm-10">@(Model.Expense.Annotation ?? "-")</dd>
</dl>

@if (expSt is ApprovalStatus.Draft or ApprovalStatus.Declined)
{
    <a asp-page="Edit" asp-route-id="@Model.Expense.Id" class="btn btn-primary">Редагувати</a>
}
<a asp-page="Index" class="btn btn-secondary">Назад</a>

