@page
@model CaseFlow.PAGES.Pages.Detective.Reports.CreateModel
@{
    ViewData["Title"] = "Створити звіт";
}

<h2>Створити звіт</h2>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @foreach (var modelState in ViewData.ModelState.Values)
        {
            @foreach (var error in modelState.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post">
    <div class="row">
        <div class="col-md-8">
            <div class="mb-3">
                <label asp-for="Input.CaseId" class="form-label">Справа</label>
                <select asp-for="Input.CaseId" class="form-control" required>
                    <option value="">-- Виберіть справу --</option>
                    @foreach (var caseItem in Model.Cases)
                    {
                        <option value="@caseItem.Id">@caseItem.Title (ID: @caseItem.Id)</option>
                    }
                </select>
                <span asp-validation-for="Input.CaseId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Summary" class="form-label">Резюме</label>
                <textarea asp-for="Input.Summary" class="form-control" rows="4" required></textarea>
                <small class="form-text text-muted">Опишіть основні результати розслідування</small>
                <span asp-validation-for="Input.Summary" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Comments" class="form-label">Коментарі</label>
                <textarea asp-for="Input.Comments" class="form-control" rows="4"></textarea>
                <small class="form-text text-muted">Додаткові коментарі (необов'язково)</small>
                <span asp-validation-for="Input.Comments" class="text-danger"></span>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Створити</button>
    <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
</form>

<partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />

