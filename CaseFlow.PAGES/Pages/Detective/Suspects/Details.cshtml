@page "{id:int}"
@model CaseFlow.PAGES.Pages.Detective.Suspects.DetailsModel
@using CaseFlow.DAL.Enums
@{
    ViewData["Title"] = "Деталі підозрюваного";
    var susSt = Model.Suspect.ApprovalStatus;
}

<h2>Деталі підозрюваного</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Suspect.Id</dd>
    <dt class="col-sm-2">Ім'я</dt>
    <dd class="col-sm-10">@Model.Suspect.FirstName</dd>
    <dt class="col-sm-2">Прізвище</dt>
    <dd class="col-sm-10">@Model.Suspect.LastName</dd>
    <dt class="col-sm-2">По батькові</dt>
    <dd class="col-sm-10">@(Model.Suspect.FatherName ?? "-")</dd>
    <dt class="col-sm-2">Псевдонім</dt>
    <dd class="col-sm-10">@(Model.Suspect.Nickname ?? "-")</dd>
    <dt class="col-sm-2">Телефон</dt>
    <dd class="col-sm-10">@(Model.Suspect.PhoneNumber ?? "-")</dd>
    <dt class="col-sm-2">Дата народження</dt>
    <dd class="col-sm-10">@(Model.Suspect.DateOfBirth?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Регіон</dt>
    <dd class="col-sm-10">@(Model.Suspect.Region ?? "-")</dd>
    <dt class="col-sm-2">Місто</dt>
    <dd class="col-sm-10">@(Model.Suspect.City ?? "-")</dd>
    <dt class="col-sm-2">Вулиця</dt>
    <dd class="col-sm-10">@(Model.Suspect.Street ?? "-")</dd>
    <dt class="col-sm-2">Будинок</dt>
    <dd class="col-sm-10">@(Model.Suspect.BuildingNumber ?? "-")</dd>
    <dt class="col-sm-2">Квартира</dt>
    <dd class="col-sm-10">@(Model.Suspect.ApartmentNumber?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Зріст</dt>
    <dd class="col-sm-10">@(Model.Suspect.Height?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Вага</dt>
    <dd class="col-sm-10">@(Model.Suspect.Weight?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Опис</dt>
    <dd class="col-sm-10">@(Model.Suspect.PhysicalDescription ?? "-")</dd>
    <dt class="col-sm-2">Судимість</dt>
    <dd class="col-sm-10">@(Model.Suspect.PriorConvictions ?? "-")</dd>
    <dt class="col-sm-2">Статус</dt>
    <dd class="col-sm-10">
        <span class="badge bg-@(susSt.ToString() == "Approved" ? "success" : susSt.ToString() == "Pending" ? "warning" : susSt.ToString() == "Declined" ? "danger" : "secondary")">
            @UkLabels.ApprovalStatusLabel(susSt)
        </span>
    </dd>
</dl>

@if (susSt is ApprovalStatus.Draft or ApprovalStatus.Declined)
{
    <a asp-page="Edit" asp-route-id="@Model.Suspect.Id" class="btn btn-primary">Редагувати</a>
}
<a asp-page="Index" class="btn btn-secondary">Назад</a>

