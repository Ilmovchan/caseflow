@{
    string currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CaseFlow.PAGES</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/dark-theme.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/modern-enhancements.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/admin-panel.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/CaseFlow.PAGES.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom mb-3 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                <i class="fas fa-search me-2"></i>CaseFlow
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1 align-items-center">
                    <!-- Главная -->
                    <li class="nav-item">
                        <a class="nav-link @(currentPage == "/Index" ? "active" : "")" asp-area="" asp-page="/Index">
                            <i class="fas fa-home me-1"></i>Головна
                        </a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <!-- Панель адміністратора -->
                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Admin/Index") ? "active" : "")"
                                   asp-area="" asp-page="/Admin/Index">
                                    <i class="fas fa-cog me-1"></i>Панель адміністратора
                                </a>
                            </li>

                            <!-- Клієнти — показывается только в разделе Clients -->
                            @if (currentPage.StartsWith("/Admin/Clients"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Admin/Clients/Index">
                                        <i class="fas fa-users me-1"></i>Клієнти
                                    </a>
                                </li>
                            }
                            
                            <!-- Детективи — показывается только в разделе Detectives -->
                            @if (currentPage.StartsWith("/Admin/Detectives"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Admin/Detectives/Index">
                                        <i class="fas fa-user-tie me-1"></i>Детективи
                                    </a>
                                </li>
                            }

                            <!-- Справи — показывается только в разделе Cases -->
                            @if (currentPage.StartsWith("/Admin/Cases"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Admin/Cases/Index">
                                        <i class="fas fa-folder-open me-1"></i>Справи
                                    </a>
                                </li>
                            }

                            <!-- Докази — показывается только в разделе Evidence -->
                            @if (currentPage.StartsWith("/Admin/Evidence"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Admin/Evidence/Index">
                                        <i class="fas fa-fingerprint me-1"></i>Докази
                                    </a>
                                </li>
                            }

                            <!-- Звіти — показывается только в разделе Reports -->
                            @if (currentPage.StartsWith("/Admin/Reports"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Admin/Reports/Index">
                                        <i class="fas fa-file-alt me-1"></i>Звіти
                                    </a>
                                </li>
                            }

                            <!-- Витрати — показывается только в разделе Expenses -->
                            @if (currentPage.StartsWith("/Admin/Expenses"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Admin/Expenses/Index">
                                        <i class="fas fa-dollar-sign me-1"></i>Витрати
                                    </a>
                                </li>
                            }

                            <!-- Підозрювані — показывается только в разделе Suspects -->
                            @if (currentPage.StartsWith("/Admin/Suspects"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Admin/Suspects/Index">
                                        <i class="fas fa-user-secret me-1"></i>Підозрювані
                                    </a>
                                </li>
                            }

                            <!-- Типи справ — показывается только в разделе CaseTypes -->
                            @if (currentPage.StartsWith("/Admin/CaseTypes"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Admin/CaseTypes/Index">
                                        <i class="fas fa-tags me-1"></i>Типи справ
                                    </a>
                                </li>
                            }
                        }

                        @if (User.IsInRole("Detective"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Detective/Index") ? "active" : "")"
                                   asp-area="" asp-page="/Detective/Index">
                                    <i class="fas fa-user-secret me-1"></i>Панель детектива
                                </a>
                            </li>

                            <!-- Справи — показывается только в разделе Cases -->
                            @if (currentPage.StartsWith("/Detective/Cases"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Detective/Cases/Index">
                                        <i class="fas fa-folder-open me-1"></i>Справи
                                    </a>
                                </li>
                            }

                            @if (currentPage.StartsWith("/Detective/Clients"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Detective/Clients/Index">
                                        <i class="fas fa-users me-1"></i>Клієнти
                                    </a>
                                </li>
                            }

                            <!-- Звіти — показывается только в разделе Reports -->
                            @if (currentPage.StartsWith("/Detective/Reports"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Detective/Reports/Index">
                                        <i class="fas fa-file-alt me-1"></i>Звіти
                                    </a>
                                </li>
                            }

                            <!-- Докази — показывается только в разделе Evidence -->
                            @if (currentPage.StartsWith("/Detective/Evidence"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Detective/Evidence/Index">
                                        <i class="fas fa-fingerprint me-1"></i>Докази
                                    </a>
                                </li>
                            }

                            <!-- Підозрювані — показывается только в разделе Suspects -->
                            @if (currentPage.StartsWith("/Detective/Suspects"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Detective/Suspects/Index">
                                        <i class="fas fa-user-secret me-1"></i>Підозрювані
                                    </a>
                                </li>
                            }

                            <!-- Витрати — показывается только в разделе Expenses -->
                            @if (currentPage.StartsWith("/Detective/Expenses"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Detective/Expenses/Index">
                                        <i class="fas fa-dollar-sign me-1"></i>Видатки
                                    </a>
                                </li>
                            }

                            @if (currentPage.StartsWith("/Detective/Account"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link active"
                                       asp-area="" asp-page="/Detective/Account/Index">
                                        <i class="fas fa-id-badge me-1"></i>Мій акаунт
                                    </a>
                                </li>
                            }
                        }
                    }
                </ul>

                <!-- Профиль / Вход -->
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user me-1"></i>@User.Identity.Name
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger ms-1">Admin</span>
                                }
                                else if (User.IsInRole("Detective"))
                                {
                                    <span class="badge bg-info ms-1">Detective</span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-page="/Admin/DetectiveAccounts/Create">
                                            <i class="fas fa-user-plus me-1"></i>Створити акаунт детектива
                                        </a>
                                    </li>
                                }
                                @if (User.IsInRole("Detective"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-page="/Detective/Account/Index">
                                            <i class="fas fa-id-badge me-1"></i>Мій акаунт
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item" asp-page="/Auth/Logout">
                                        <i class="fas fa-sign-out-alt me-1"></i>Вихід
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Auth/Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Вхід
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2025 - CaseFlow - <a asp-area="" asp-page="/Privacy">Конфіденційність</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/table-rows.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
