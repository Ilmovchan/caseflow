@page
@model CaseFlow.PAGES.Pages.Auth.LogoutModel
@{
    ViewData["Title"] = "Вихід";
    Layout = "_AuthLayout";
}

<div class="auth-header">
    <h1><i class="fas fa-sign-out-alt me-2"></i>Вихід</h1>
    <p>Ви впевнені, що хочете вийти з системи?</p>
</div>

<form method="post">
    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-sign-out-alt me-2"></i>Так, вийти
        </button>
        <a href="javascript:history.back()" class="btn btn-outline-light">
            <i class="fas fa-arrow-left me-2"></i>Повернутися
        </a>
    </div>
</form>
