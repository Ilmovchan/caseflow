@page
@model CaseFlow.PAGES.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Вхід";
    Layout = "_AuthLayout";
}

<div class="auth-header">
    <h1><i class="fas fa-shield-alt me-2"></i>CaseFlow</h1>
    <p>Система управління детективним агентством</p>
</div>

<form method="post">
    <div class="mb-3">
        <label asp-for="Username" class="form-label">
            <i class="fas fa-user me-1"></i>Ім'я користувача
        </label>
        <input asp-for="Username" class="form-control" placeholder="Введіть ім'я користувача" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Password" class="form-label">
            <i class="fas fa-lock me-1"></i>Пароль
        </label>
        <input asp-for="Password" type="password" class="form-control" placeholder="Введіть пароль" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    
    <div class="mb-3 form-check">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label">
            Запам'ятати мене
        </label>
    </div>
    
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@Model.ErrorMessage
        </div>
    }
    
    <div class="d-grid">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-sign-in-alt me-2"></i>Увійти
        </button>
    </div>
</form>

