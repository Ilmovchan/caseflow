@page
@model CaseFlow.PAGES.Pages.Admin.Suspects.IndexModel
@{
    ViewData["Title"] = "Suspects";
}

<h2>Suspects</h2>

<p>
    <a asp-page="../Index" class="btn btn-secondary">Back to Admin</a>
    <a asp-page="/Index" class="btn btn-link">Home</a>
</p>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">All Suspects</h6>
                <p class="card-text">@Model.AllSuspects.Count items</p>
                <a asp-page="All" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">Pending Approval</h6>
                <p class="card-text">@Model.PendingSuspects.Count items</p>
                <a asp-page="Pending" class="btn btn-outline-warning btn-sm">View Pending</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">By Case</h6>
                <p class="card-text">Filter by case</p>
                <a asp-page="ByCase" class="btn btn-outline-info btn-sm">View by Case</a>
            </div>
        </div>
    </div>
</div>

<h3>Recent Suspects</h3>
<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Nickname</th>
        <th>Phone</th>
        <th>Region</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var s in Model.AllSuspects.Take(10))
    {
        <tr>
            <td>@s.Id</td>
            <td>@(s.LastName ?? "") @(s.FirstName ?? "")</td>
            <td>@(s.Nickname ?? "-")</td>
            <td>@(s.PhoneNumber ?? "-")</td>
            <td>@(s.Region ?? "-")</td>
            <td>
                <a asp-page="Details" asp-route-id="@s.Id">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
