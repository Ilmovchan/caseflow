@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Suspects.DetailsModel
@{
    ViewData["Title"] = "Деталі підозрюваного";
}

<h2>Деталі підозрюваного</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Suspect.Id</dd>
    <dt class="col-sm-2">ПІБ</dt>
    <dd class="col-sm-10">@(Model.Suspect.LastName ?? "") @(Model.Suspect.FirstName ?? "") @(Model.Suspect.FatherName ?? "")</dd>
    <dt class="col-sm-2">Псевдонім</dt>
    <dd class="col-sm-10">@(Model.Suspect.Nickname ?? "-")</dd>
    <dt class="col-sm-2">Телефон</dt>
    <dd class="col-sm-10">@(Model.Suspect.PhoneNumber ?? "-")</dd>
    <dt class="col-sm-2">Дата народження</dt>
    <dd class="col-sm-10">@(Model.Suspect.DateOfBirth?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Адреса</dt>
    <dd class="col-sm-10">@(Model.Suspect.Region ?? ""), @(Model.Suspect.City ?? ""), @(Model.Suspect.Street ?? "") @(Model.Suspect.BuildingNumber ?? ""), кв. @(Model.Suspect.ApartmentNumber?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Фізичний опис</dt>
    <dd class="col-sm-10">@(Model.Suspect.PhysicalDescription ?? "-")</dd>
    <dt class="col-sm-2">Зріст</dt>
    <dd class="col-sm-10">@(Model.Suspect.Height?.ToString() ?? "-") см</dd>
    <dt class="col-sm-2">Вага</dt>
    <dd class="col-sm-10">@(Model.Suspect.Weight?.ToString() ?? "-") кг</dd>
    <dt class="col-sm-2">Попередні судимості</dt>
    <dd class="col-sm-10">@(Model.Suspect.PriorConvictions ?? "-")</dd>
</dl>

<p>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</p>
