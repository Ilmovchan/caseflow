@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Suspects.DetailsModel
@{
    ViewData["Title"] = "Suspect Details";
}

<h2>Suspect Details</h2>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Suspect.Id</dd>
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@(Model.Suspect.LastName ?? "") @(Model.Suspect.FirstName ?? "") @(Model.Suspect.FatherName ?? "")</dd>
    <dt class="col-sm-2">Nickname</dt>
    <dd class="col-sm-10">@(Model.Suspect.Nickname ?? "-")</dd>
    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@(Model.Suspect.PhoneNumber ?? "-")</dd>
    <dt class="col-sm-2">Date of Birth</dt>
    <dd class="col-sm-10">@(Model.Suspect.DateOfBirth?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@(Model.Suspect.Region ?? ""), @(Model.Suspect.City ?? ""), @(Model.Suspect.Street ?? "") @(Model.Suspect.BuildingNumber ?? ""), apt @(Model.Suspect.ApartmentNumber?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Physical Description</dt>
    <dd class="col-sm-10">@(Model.Suspect.PhysicalDescription ?? "-")</dd>
    <dt class="col-sm-2">Height</dt>
    <dd class="col-sm-10">@(Model.Suspect.Height?.ToString() ?? "-") cm</dd>
    <dt class="col-sm-2">Weight</dt>
    <dd class="col-sm-10">@(Model.Suspect.Weight?.ToString() ?? "-") kg</dd>
    <dt class="col-sm-2">Prior Convictions</dt>
    <dd class="col-sm-10">@(Model.Suspect.PriorConvictions ?? "-")</dd>
</dl>

<p>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</p>
