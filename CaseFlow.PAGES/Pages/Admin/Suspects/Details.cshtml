@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Suspects.DetailsModel
@{
    ViewData["Title"] = "Деталі підозрюваного";
}

<h2>Деталі підозрюваного</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Suspect.Id</dd>
    <dt class="col-sm-2">ПІБ</dt>
    <dd class="col-sm-10">@(Model.Suspect.LastName ?? "") @(Model.Suspect.FirstName ?? "") @(Model.Suspect.FatherName ?? "")</dd>
    <dt class="col-sm-2">Псевдонім</dt>
    <dd class="col-sm-10">@(Model.Suspect.Nickname ?? "-")</dd>
    <dt class="col-sm-2">Телефон</dt>
    <dd class="col-sm-10">@(Model.Suspect.PhoneNumber ?? "-")</dd>
    <dt class="col-sm-2">Дата народження</dt>
    <dd class="col-sm-10">@(Model.Suspect.DateOfBirth?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Адреса</dt>
    <dd class="col-sm-10">@(Model.Suspect.Region ?? ""), @(Model.Suspect.City ?? ""), @(Model.Suspect.Street ?? "") @(Model.Suspect.BuildingNumber ?? ""), кв. @(Model.Suspect.ApartmentNumber?.ToString() ?? "-")</dd>
    <dt class="col-sm-2">Фізичний опис</dt>
    <dd class="col-sm-10">@(Model.Suspect.PhysicalDescription ?? "-")</dd>
    <dt class="col-sm-2">Зріст</dt>
    <dd class="col-sm-10">@(Model.Suspect.Height?.ToString() ?? "-") см</dd>
    <dt class="col-sm-2">Вага</dt>
    <dd class="col-sm-10">@(Model.Suspect.Weight?.ToString() ?? "-") кг</dd>
    <dt class="col-sm-2">Попередні судимості</dt>
    <dd class="col-sm-10">@(Model.Suspect.PriorConvictions ?? "-")</dd>
</dl>

<div class="mt-4">
    <h4 class="mb-3">Пов’язані справи</h4>
    @if (Model.ConnectedCases.Count == 0)
    {
        <div class="text-muted">Для цього підозрюваного немає пов’язаних справ.</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th class="text-center">ID</th>
                <th>Назва</th>
                <th>Клієнт</th>
                <th>Детектив</th>
                <th>Тип справи</th>
                <th class="text-center">Початок</th>
                <th class="text-center">Термін</th>
                <th class="text-center">Закриття</th>
                <th class="text-center">Статус</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.ConnectedCases)
            {
                <tr class="clickable-row" data-href="@Url.Page("/Admin/Cases/Details", new { id = c.Id })">
                    <td class="text-center">@c.Id</td>
                    <td>@c.Title</td>
                    <td>@(c.Client != null ? $"{c.Client.LastName} {c.Client.FirstName}" : "-")</td>
                    <td>@(c.Detective != null ? $"{c.Detective.LastName} {c.Detective.FirstName}" : "-")</td>
                    <td>@(c.CaseType?.Name ?? "-")</td>
                    <td class="text-center">@c.StartDate</td>
                    <td class="text-center">@c.DeadlineDate</td>
                    <td class="text-center">@(c.CloseDate?.ToString() ?? "-")</td>
                    <td class="text-center">
                        @{
                            var isOverdue = c.Status.ToString() == "Opened" && c.DeadlineDate < DateOnly.FromDateTime(DateTime.Now);
                            var statusClass = isOverdue
                                ? "danger"
                                : c.Status.ToString() == "Closed"
                                    ? "success"
                                    : c.Status.ToString() == "Paused"
                                        ? "secondary"
                                        : "warning";
                            var statusText = isOverdue
                                ? "Протерміновано"
                                : c.Status.ToString() == "Closed"
                                    ? "Закрито"
                                    : c.Status.ToString() == "Paused"
                                        ? "Призупинено"
                                        : "Відкрито";
                        }
                        <span class="badge bg-@statusClass">@statusText</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<p>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</p>
