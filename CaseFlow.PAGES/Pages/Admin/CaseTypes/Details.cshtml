@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.CaseTypes.DetailsModel
@{
    ViewData["Title"] = "Case Type Details";
}

<h2>Case Type Details</h2>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.CaseType.Id</dd>
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.CaseType.Name</dd>
    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.CaseType.Price</dd>
</dl>

<p>
    <a asp-page="Edit" asp-route-id="@Model.CaseType.Id" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</p>
