@page
@model CaseFlow.PAGES.Pages.Admin.CaseTypes.IndexModel
@{
    ViewData["Title"] = "Типи справ";
}

<h2>Типи справ</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Створити новий тип справи</a>
    <a asp-page="../Index" class="btn btn-secondary">Назад</a>
    <a asp-page="/Index" class="btn btn-link">Головна</a>
</p>

<table class="table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Назва</th>
        <th>Ціна</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var ct in Model.CaseTypes)
    {
        <tr>
            <td>@ct.Id</td>
            <td>@ct.Name</td>
            <td>@ct.Price</td>
            <td>
                <a asp-page="Details" asp-route-id="@ct.Id">Деталі</a> |
                <a asp-page="Edit" asp-route-id="@ct.Id">Редагувати</a> |
                <a asp-page="Delete" asp-route-id="@ct.Id">Видалити</a>
            </td>
        </tr>
    }
    </tbody>
</table>
