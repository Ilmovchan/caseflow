@page
@model CaseFlow.PAGES.Pages.Admin.CaseTypes.IndexModel
@{
    ViewData["Title"] = "Типи справ";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary filter-btn" data-table="casetypes-table">
            <i class="fas fa-filter me-1"></i>Фільтр
        </button>
        <a asp-page="Create" class="btn btn-primary">Створити новий тип справи</a>
    </div>
</div>

<table id="casetypes-table" class="table sortable-table paginated-table">
    <thead>
    <tr>
        <th class="text-center">ID</th>
        <th class="text-center">Назва</th>
        <th class="text-center">Ціна</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var ct in Model.CaseTypes)
    {
        <tr class="clickable-row" data-href="@Url.Page("Details", new { id = ct.Id })">
            <td>@ct.Id</td>
            <td>@ct.Name</td>
            <td>@ct.Price</td>
        </tr>
    }
    </tbody>
</table>

<!-- Server-side Pagination -->
@if (Model.PagedCaseTypes.TotalPages > 1)
{
    <nav aria-label="CaseTypes pagination" class="mt-3">
        <ul class="pagination justify-content-center">
            @if (Model.PagedCaseTypes.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage - 1)">Попередня</a>
                </li>
            }
            
            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.PagedCaseTypes.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?pageNumber=@i">@i</a>
                </li>
            }
            
            @if (Model.PagedCaseTypes.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage + 1)">Наступна</a>
                </li>
            }
        </ul>
    </nav>
    
    <div class="text-center text-muted">
        Показано @((Model.CurrentPage - 1) * Model.PageSize + 1)-@(Math.Min(Model.CurrentPage * Model.PageSize, Model.PagedCaseTypes.TotalCount)) з @Model.PagedCaseTypes.TotalCount записів
    </div>
}

<div class="mb-5"></div>

@section Scripts {
    <script src="~/js/table-sorting.js"></script>
    <script src="~/js/table-filters.js"></script>
    <script src="~/js/table-pagination.js"></script>
}
