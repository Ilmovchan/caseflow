@page
@model CaseFlow.PAGES.Pages.Admin.Reports.IndexModel
@{
    ViewData["Title"] = "Звіти";
}

<h2>Звіти</h2>

<p>
    <a asp-page="../Index" class="btn btn-secondary">Назад до адміністратора</a>
    <a asp-page="/Index" class="btn btn-link">Головна</a>
</p>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">Всі звіти</h6>
                <p class="card-text">@Model.AllReports.Count елементів</p>
                <a asp-page="All" class="btn btn-outline-primary btn-sm">Переглянути всі</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">Очікують затвердження</h6>
                <p class="card-text">@Model.PendingReports.Count елементів</p>
                <a asp-page="Pending" class="btn btn-outline-warning btn-sm">Переглянути очікуючі</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">За справою</h6>
                <p class="card-text">Фільтр за справою</p>
                <a asp-page="ByCase" class="btn btn-outline-info btn-sm">Переглянути за справою</a>
            </div>
        </div>
    </div>
</div>

<h3>Останні звіти</h3>
<table class="table sortable-table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Справа</th>
        <th>Резюме</th>
        <th>Дата звіту</th>
        <th>Статус</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var r in Model.AllReports.Take(10))
    {
        <tr>
            <td>@r.Id</td>
            <td>@r.CaseTitle</td>
            <td>@(r.Summary.Length > 50 ? r.Summary.Substring(0, 50) + "..." : r.Summary)</td>
            <td>@r.ReportDate.ToString("yyyy-MM-dd")</td>
            <td>
                <span class="badge bg-@(r.ApprovalStatus.ToString() == "Approved" ? "success" : r.ApprovalStatus.ToString() == "Pending" ? "warning" : "secondary")">
                    @r.ApprovalStatus
                </span>
            </td>
            <td>
                <a asp-page="Details" asp-route-id="@r.Id">Деталі</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <script src="~/js/table-sorting.js"></script>
}
