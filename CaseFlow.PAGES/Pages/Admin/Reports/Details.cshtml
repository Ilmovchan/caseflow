@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Reports.DetailsModel
@{
    ViewData["Title"] = "Report Details";
}

<h2>Report Details</h2>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Report.Id</dd>
    <dt class="col-sm-2">Case ID</dt>
    <dd class="col-sm-10">@Model.Report.CaseId</dd>
    <dt class="col-sm-2">Report Date</dt>
    <dd class="col-sm-10">@Model.Report.ReportDate</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">
        <span class="badge bg-@(Model.Report.ApprovalStatus.ToString() == "Approved" ? "success" : Model.Report.ApprovalStatus.ToString() == "Pending" ? "warning" : "secondary")">
            @Model.Report.ApprovalStatus
        </span>
    </dd>
    <dt class="col-sm-2">Summary</dt>
    <dd class="col-sm-10">@Model.Report.Summary</dd>
    <dt class="col-sm-2">Comments</dt>
    <dd class="col-sm-10">@(Model.Report.Comments ?? "-")</dd>
</dl>

<p>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</p>
