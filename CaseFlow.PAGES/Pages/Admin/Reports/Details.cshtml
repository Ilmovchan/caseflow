@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Reports.DetailsModel
@{
    ViewData["Title"] = "Деталі звіту";
}

<h2>Деталі звіту</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Report.Id</dd>
    <dt class="col-sm-2">Пов’язана справа</dt>
    <dd class="col-sm-10">
        <a asp-page="/Admin/Cases/Details" asp-route-id="@Model.Report.CaseId">
            @Model.Report.CaseId
        </a>
    </dd>
    <dt class="col-sm-2">Дата звіту</dt>
    <dd class="col-sm-10">@Model.Report.ReportDate</dd>
    <dt class="col-sm-2">Статус</dt>
    <dd class="col-sm-10">
        <span class="badge bg-@(Model.Report.ApprovalStatus.ToString() == "Approved" ? "success" : Model.Report.ApprovalStatus.ToString() == "Pending" ? "warning" : Model.Report.ApprovalStatus.ToString() == "Declined" ? "danger" : "secondary")">
            @UkLabels.ApprovalStatusLabel(Model.Report.ApprovalStatus)
        </span>
    </dd>
    <dt class="col-sm-2">Створив детектив</dt>
    <dd class="col-sm-10">
        @if (Model.Report.CreatedByDetectiveId is int creatorId && Model.Report.CreatedByDetective != null)
        {
            var cd = Model.Report.CreatedByDetective;
            <a asp-page="/Admin/Detectives/Details" asp-route-id="@creatorId">#@creatorId — @cd.LastName @cd.FirstName</a>
        }
        else if (Model.Report.CreatedByDetectiveId is int onlyId)
        {
            <a asp-page="/Admin/Detectives/Details" asp-route-id="@onlyId">#@onlyId</a>
        }
        else
        {
            <span>—</span>
        }
    </dd>
    <dt class="col-sm-2">Резюме</dt>
    <dd class="col-sm-10">@Model.Report.Summary</dd>
    <dt class="col-sm-2">Коментарі</dt>
    <dd class="col-sm-10">@(Model.Report.Comments ?? "-")</dd>
</dl>

<p>
    <a asp-page-handler="ExportPdf" asp-route-id="@Model.Report.Id" class="btn btn-outline-danger text-white">Export PDF</a>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</p>
