@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Detectives.DetailsModel
@{
    ViewData["Title"] = "Detective Details";
}

<h2>Detective Details</h2>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Detective.Id</dd>
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Detective.LastName @Model.Detective.FirstName @Model.Detective.FatherName</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Detective.Status</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Detective.Email</dd>
    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Detective.PhoneNumber</dd>
    <dt class="col-sm-2">Salary</dt>
    <dd class="col-sm-10">@Model.Detective.Salary</dd>
    <dt class="col-sm-2">Hire Date</dt>
    <dd class="col-sm-10">@Model.Detective.HireDate</dd>
</dl>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Detective.Id" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</p>

