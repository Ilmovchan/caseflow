@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Detectives.DetailsModel
@{
    ViewData["Title"] = "Деталі детектива";
}

<h2>Деталі детектива</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Detective.Id</dd>
    <dt class="col-sm-2">ПІБ</dt>
    <dd class="col-sm-10">@Model.Detective.LastName @Model.Detective.FirstName @Model.Detective.FatherName</dd>
    <dt class="col-sm-2">Статус</dt>
    <dd class="col-sm-10">@UkLabels.DetectiveStatusLabel(Model.Detective.Status)</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Detective.Email</dd>
    <dt class="col-sm-2">Телефон</dt>
    <dd class="col-sm-10">@Model.Detective.PhoneNumber</dd>
    <dt class="col-sm-2">Зарплата</dt>
    <dd class="col-sm-10">@Model.Detective.Salary</dd>
    <dt class="col-sm-2">Дата найму</dt>
    <dd class="col-sm-10">@Model.Detective.HireDate</dd>
</dl>

<div class="mt-4">
    <h4 class="mb-3">Пов’язані справи</h4>
    @if (Model.ConnectedCases.Count == 0)
    {
        <div class="text-muted">У цього детектива немає пов’язаних справ.</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th class="text-center">ID</th>
                <th>Назва</th>
                <th>Клієнт</th>
                <th>Тип справи</th>
                <th class="text-center">Початок</th>
                <th class="text-center">Термін</th>
                <th class="text-center">Закриття</th>
                <th class="text-center">Статус</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.ConnectedCases)
            {
                <tr class="clickable-row" data-href="@Url.Page("/Admin/Cases/Details", new { id = c.Id })">
                    <td class="text-center">@c.Id</td>
                    <td>@c.Title</td>
                    <td>
                        @if (c.Client != null)
                        {
                            <a asp-page="/Admin/Clients/Details" asp-route-id="@c.ClientId" class="text-decoration-none" onclick="event.stopPropagation();">@($"{c.Client.LastName} {c.Client.FirstName}")</a>
                        }
                        else { <span>—</span> }
                    </td>
                    <td>
                        @if (c.CaseType != null)
                        {
                            <a asp-page="/Admin/CaseTypes/Details" asp-route-id="@c.CaseTypeId" class="text-decoration-none" onclick="event.stopPropagation();">@c.CaseType.Name</a>
                        }
                        else { <span>—</span> }
                    </td>
                    <td class="text-center">@c.StartDate</td>
                    <td class="text-center">@c.DeadlineDate</td>
                    <td class="text-center">@(c.CloseDate?.ToString() ?? "-")</td>
                    <td class="text-center">
                        @{
                            var isOverdue = c.Status.ToString() == "Opened" && c.DeadlineDate < DateOnly.FromDateTime(DateTime.Now);
                            var statusClass = isOverdue
                                ? "danger"
                                : c.Status.ToString() == "Closed"
                                    ? "success"
                                    : c.Status.ToString() == "Paused"
                                        ? "secondary"
                                        : "warning";
                            var statusText = isOverdue
                                ? "Протерміновано"
                                : c.Status.ToString() == "Closed"
                                    ? "Закрито"
                                    : c.Status.ToString() == "Paused"
                                        ? "Призупинено"
                                        : "Відкрито";
                        }
                        <span class="badge bg-@statusClass">@statusText</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Detective.Id" class="btn btn-primary">Редагувати</a>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</p>

