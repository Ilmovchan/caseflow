@page
@model CaseFlow.PAGES.Pages.Admin.Detectives.IndexModel
@{
    ViewData["Title"] = "Detectives";
}

<h2>Detectives</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Detective</a>
    <a asp-page="../Index" class="btn btn-secondary">Back</a>
    <a asp-page="/Index" class="btn btn-link">Home</a>
    </p>

<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Status</th>
        <th>Hire Date</th>
        <th>Email</th>
        <th>Phone</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var d in Model.Detectives)
    {
        <tr>
            <td>@d.Id</td>
            <td>@d.LastName @d.FirstName</td>
            <td>@d.Status</td>
            <td>@d.HireDate</td>
            <td>@d.Email</td>
            <td>@d.PhoneNumber</td>
            <td>
                <a asp-page="Details" asp-route-id="@d.Id">Details</a> |
                <a asp-page="Edit" asp-route-id="@d.Id">Edit</a> |
                <a asp-page="Delete" asp-route-id="@d.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
    </table>

