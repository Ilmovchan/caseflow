@page
@model CaseFlow.PAGES.Pages.Admin.Detectives.IndexModel
@{
    ViewData["Title"] = "Детективи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Детективи</h2>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary filter-btn" data-table="detectives-table">
            <i class="fas fa-filter me-1"></i>Фільтр
        </button>
        <a asp-page="Create" class="btn btn-primary">Створити нового детектива</a>
    </div>
</div>

<p>
    <a asp-page="../Index" class="btn btn-secondary">Назад</a>
    <a asp-page="/Index" class="btn btn-link">Головна</a>
</p>

<table id="detectives-table" class="table sortable-table paginated-table">
    <thead>
    <tr>
        <th class="text-center">ID</th>
        <th class="text-center">Ім'я</th>
        <th class="text-center">Статус</th>
        <th class="text-center">Дата найму</th>
        <th class="text-center">Email</th>
        <th class="text-center">Телефон</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var d in Model.Detectives)
    {
        <tr class="clickable-row" data-href="@Url.Page("Details", new { id = d.Id })">
            <td>@d.Id</td>
            <td>@d.FullName</td>
            <td>@d.Status</td>
            <td>@d.HireDate</td>
            <td>@d.Email</td>
            <td>@d.PhoneNumber</td>
        </tr>
    }
    </tbody>
    </table>

    <!-- Server-side Pagination -->
    @if (Model.PagedDetectives.TotalPages > 1)
    {
        <nav aria-label="Detectives pagination" class="mt-3">
            <ul class="pagination justify-content-center">
                @if (Model.PagedDetectives.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="?pageNumber=@(Model.CurrentPage - 1)">Попередня</a>
                    </li>
                }
                
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.PagedDetectives.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?pageNumber=@i">@i</a>
                    </li>
                }
                
                @if (Model.PagedDetectives.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="?pageNumber=@(Model.CurrentPage + 1)">Наступна</a>
                    </li>
                }
            </ul>
        </nav>
        
        <div class="text-center text-muted">
            Показано @((Model.CurrentPage - 1) * Model.PageSize + 1)-@(Math.Min(Model.CurrentPage * Model.PageSize, Model.PagedDetectives.TotalCount)) з @Model.PagedDetectives.TotalCount записів
        </div>
    }

<div class="mb-5"></div>

@section Scripts {
    <script src="~/js/table-sorting.js"></script>
    <script src="~/js/table-filters.js"></script>
    <script src="~/js/table-pagination.js"></script>
}

