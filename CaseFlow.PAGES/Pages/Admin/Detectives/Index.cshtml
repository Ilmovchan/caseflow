@page
@model CaseFlow.PAGES.Pages.Admin.Detectives.IndexModel
@{
    ViewData["Title"] = "Детективи";
}

<h2>Детективи</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Створити нового детектива</a>
    <a asp-page="../Index" class="btn btn-secondary">Назад</a>
    <a asp-page="/Index" class="btn btn-link">Головна</a>
    </p>

<table class="table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Ім'я</th>
        <th>Статус</th>
        <th>Дата найму</th>
        <th>Email</th>
        <th>Телефон</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var d in Model.Detectives)
    {
        <tr>
            <td>@d.Id</td>
            <td>@d.FullName</td>
            <td>@d.Status</td>
            <td>@d.HireDate</td>
            <td>@d.Email</td>
            <td>@d.PhoneNumber</td>
            <td>
                <a asp-page="Details" asp-route-id="@d.Id">Деталі</a> |
                <a asp-page="Edit" asp-route-id="@d.Id">Редагувати</a> |
                <a asp-page="Delete" asp-route-id="@d.Id">Видалити</a>
            </td>
        </tr>
    }
    </tbody>
    </table>

