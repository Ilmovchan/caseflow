@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Detectives.DeleteModel
@{
    ViewData["Title"] = "Видалити детектива";
}

<h2>Видалити детектива</h2>

<div class="alert alert-warning">
    Ви впевнені, що хочете видалити детектива <strong>#@Model.Detective.Id</strong> - "@Model.Detective.LastName @Model.Detective.FirstName"?
</div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
    <a asp-page="Details" asp-route-id="@Model.Detective.Id" class="btn btn-link">Деталі</a>
</form>

