@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Detectives.DeleteModel
@{
    ViewData["Title"] = "Delete Detective";
}

<h2>Delete Detective</h2>

<div class="alert alert-warning">
    Are you sure you want to delete detective <strong>#@Model.Detective.Id</strong> - "@Model.Detective.LastName @Model.Detective.FirstName"?
</div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    <a asp-page="Details" asp-route-id="@Model.Detective.Id" class="btn btn-link">Details</a>
    </form>

