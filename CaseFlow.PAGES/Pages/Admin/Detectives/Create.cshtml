@page
@model CaseFlow.PAGES.Pages.Admin.Detectives.CreateModel
@{
    ViewData["Title"] = "Створити детектива";
}

<h2>Створити детектива</h2>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @foreach (var modelState in ViewData.ModelState.Values)
        {
            @foreach (var error in modelState.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.FirstName" class="form-label"></label>
                <input asp-for="Input.FirstName" class="form-control" pattern="^[А-ЯІЇЄа-яіїє]+$" required />
                <small class="form-text text-muted">Тільки українські букви</small>
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.LastName" class="form-label"></label>
                <input asp-for="Input.LastName" class="form-control" pattern="^[А-ЯІЇЄа-яіїє]+$" required />
                <small class="form-text text-muted">Тільки українські букви</small>
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.FatherName" class="form-label"></label>
                <input asp-for="Input.FatherName" class="form-control" pattern="^[А-ЯІЇЄа-яіїє]+$" />
                <small class="form-text text-muted">Тільки українські букви</small>
                <span asp-validation-for="Input.FatherName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" type="email" required />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+380XXXXXXXXX" pattern="^\+380\d{9}$" required />
                <small class="form-text text-muted">Формат: +380XXXXXXXXX (наприклад, +380991234567)</small>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.DateOfBirth" class="form-label"></label>
                <input asp-for="Input.DateOfBirth" class="form-control" type="date" required />
                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.Region" class="form-label"></label>
                <input asp-for="Input.Region" class="form-control" pattern="^[А-ЯІЇЄа-яіїє]+$" required />
                <small class="form-text text-muted">Тільки українські букви, без пробілів (наприклад, Одеса)</small>
                <span asp-validation-for="Input.Region" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.City" class="form-label"></label>
                <input asp-for="Input.City" class="form-control" pattern="^[А-ЯІЇЄа-яіїє\-]+$" required />
                <small class="form-text text-muted">Українські букви та дефіси (наприклад, Одеса)</small>
                <span asp-validation-for="Input.City" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Street" class="form-label"></label>
                <input asp-for="Input.Street" class="form-control" pattern="^[А-ЯІЇЄа-яіїє\s\-]+$" required />
                <small class="form-text text-muted">Українські букви, пробіли та дефіси (наприклад, Дерибасівська)</small>
                <span asp-validation-for="Input.Street" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.BuildingNumber" class="form-label"></label>
                <input asp-for="Input.BuildingNumber" class="form-control" pattern="^[0-9/]+$" required />
                <small class="form-text text-muted">Тільки цифри та слеші (наприклад, 126/1)</small>
                <span asp-validation-for="Input.BuildingNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ApartmentNumber" class="form-label"></label>
                <input asp-for="Input.ApartmentNumber" class="form-control" type="number" min="1" />
                <span asp-validation-for="Input.ApartmentNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Salary" class="form-label"></label>
                <input asp-for="Input.Salary" class="form-control" type="number" step="0.01" min="0" required />
                <span asp-validation-for="Input.Salary" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.PersonalNotes" class="form-label"></label>
                <textarea asp-for="Input.PersonalNotes" class="form-control"></textarea>
                <span asp-validation-for="Input.PersonalNotes" class="text-danger"></span>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Створити</button>
    <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
</form>

<partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />

