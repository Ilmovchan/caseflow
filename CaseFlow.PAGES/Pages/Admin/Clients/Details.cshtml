@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Clients.DetailsModel
@{
    ViewData["Title"] = "Деталі клієнта";
}

<h2>Деталі клієнта</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Client.Id</dd>
    <dt class="col-sm-2">ПІБ</dt>
    <dd class="col-sm-10">@Model.Client.LastName @Model.Client.FirstName @Model.Client.FatherName</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Client.Email</dd>
    <dt class="col-sm-2">Телефон</dt>
    <dd class="col-sm-10">@Model.Client.PhoneNumber</dd>
    <dt class="col-sm-2">Дата народження</dt>
    <dd class="col-sm-10">@Model.Client.DateOfBirth</dd>
    <dt class="col-sm-2">Адреса</dt>
    <dd class="col-sm-10">@Model.Client.Region, @Model.Client.City, @Model.Client.Street @Model.Client.BuildingNumber, кв. @Model.Client.ApartmentNumber</dd>
    <dt class="col-sm-2">Зареєстровано</dt>
    <dd class="col-sm-10">@Model.Client.RegistrationDate</dd>
</dl>

<div class="mt-4">
    <h4 class="mb-3">Пов’язані справи</h4>
    @if (Model.ConnectedCases.Count == 0)
    {
        <div class="text-muted">У цього клієнта немає пов’язаних справ.</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th class="text-center">ID</th>
                <th>Назва</th>
                <th>Детектив</th>
                <th>Тип справи</th>
                <th class="text-center">Початок</th>
                <th class="text-center">Термін</th>
                <th class="text-center">Закриття</th>
                <th class="text-center">Статус</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.ConnectedCases)
            {
                <tr class="clickable-row" data-href="@Url.Page("/Admin/Cases/Details", new { id = c.Id })">
                    <td class="text-center">@c.Id</td>
                    <td>@c.Title</td>
                    <td>@(c.Detective != null ? $"{c.Detective.LastName} {c.Detective.FirstName}" : "-")</td>
                    <td>@(c.CaseType?.Name ?? "-")</td>
                    <td class="text-center">@c.StartDate</td>
                    <td class="text-center">@c.DeadlineDate</td>
                    <td class="text-center">@(c.CloseDate?.ToString() ?? "-")</td>
                    <td class="text-center">
                        @{
                            var isOverdue = c.Status.ToString() == "Opened" && c.DeadlineDate < DateOnly.FromDateTime(DateTime.Now);
                            var statusClass = isOverdue
                                ? "danger"
                                : c.Status.ToString() == "Closed"
                                    ? "success"
                                    : c.Status.ToString() == "Paused"
                                        ? "secondary"
                                        : "warning";
                            var statusText = isOverdue
                                ? "Протерміновано"
                                : c.Status.ToString() == "Closed"
                                    ? "Закрито"
                                    : c.Status.ToString() == "Paused"
                                        ? "Призупинено"
                                        : "Відкрито";
                        }
                        <span class="badge bg-@statusClass">@statusText</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Client.Id" class="btn btn-primary">Редагувати</a>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</p>

