@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Clients.DetailsModel
@{
    ViewData["Title"] = "Client Details";
}

<h2>Client Details</h2>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Client.Id</dd>
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Client.LastName @Model.Client.FirstName @Model.Client.FatherName</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Client.Email</dd>
    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Client.PhoneNumber</dd>
    <dt class="col-sm-2">DOB</dt>
    <dd class="col-sm-10">@Model.Client.DateOfBirth</dd>
    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@Model.Client.Region, @Model.Client.City, @Model.Client.Street @Model.Client.BuildingNumber, apt @Model.Client.ApartmentNumber</dd>
    <dt class="col-sm-2">Registered</dt>
    <dd class="col-sm-10">@Model.Client.RegistrationDate</dd>
</dl>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Client.Id" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</p>

