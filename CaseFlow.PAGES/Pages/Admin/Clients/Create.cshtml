@page
@model CaseFlow.PAGES.Pages.Admin.Clients.CreateModel
@{
    ViewData["Title"] = "Створити клієнта";
}

<h2>Створити клієнта</h2>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @foreach (var modelState in ViewData.ModelState.Values)
        {
            @foreach (var error in modelState.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.FirstName" class="form-label">Ім'я</label>
                <input asp-for="Input.FirstName" class="form-control" pattern="^[А-ЯІЇЄа-яіїє]+$" placeholder="Тільки українські букви" required />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.LastName" class="form-label">Прізвище</label>
                <input asp-for="Input.LastName" class="form-control" pattern="^[А-ЯІЇЄа-яіїє]+$" placeholder="Тільки українські букви" required />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.FatherName" class="form-label">По батькові</label>
                <input asp-for="Input.FatherName" class="form-control" pattern="^[А-ЯІЇЄа-яіїє]+$" placeholder="Тільки українські букви" />
                <span asp-validation-for="Input.FatherName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" type="email" placeholder="example@domain.com" required />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.PhoneNumber" class="form-label">Номер телефону</label>
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+380XXXXXXXXX (наприклад, +380991234567)" pattern="^\+380\d{9}$" required />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.DateOfBirth" class="form-label">Дата народження</label>
                <input asp-for="Input.DateOfBirth" class="form-control" type="date" required />
                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Input.Region" class="form-label">Область</label>
                <input asp-for="Input.Region" class="form-control" pattern="^[А-ЯІЇЄа-яіїє]+$" placeholder="Тільки українські букви, без пробілів (наприклад, Одеса)" required />
                <span asp-validation-for="Input.Region" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.City" class="form-label">Місто</label>
                <input asp-for="Input.City" class="form-control" pattern="^[А-ЯІЇЄа-яіїє\-]+$" placeholder="Українські букви та дефіси (наприклад, Одеса)" required />
                <span asp-validation-for="Input.City" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Street" class="form-label">Вулиця</label>
                <input asp-for="Input.Street" class="form-control" pattern="^[А-ЯІЇЄа-яіїє\s\-]+$" placeholder="Українські букви, пробіли та дефіси (наприклад, Дерибасівська)" required />
                <span asp-validation-for="Input.Street" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.BuildingNumber" class="form-label">Номер будинку</label>
                <input asp-for="Input.BuildingNumber" class="form-control" pattern="^[0-9/]+$" placeholder="Тільки цифри та слеші (наприклад, 126/1)" required />
                <span asp-validation-for="Input.BuildingNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ApartmentNumber" class="form-label">Номер квартири</label>
                <input asp-for="Input.ApartmentNumber" class="form-control" />
                <span asp-validation-for="Input.ApartmentNumber" class="text-danger"></span>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Створити</button>
    <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
</form>

<partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />

