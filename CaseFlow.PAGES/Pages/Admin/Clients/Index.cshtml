@page
@model CaseFlow.PAGES.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "Clients";
}

<h2>Clients</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Client</a>
    <a asp-page="../Index" class="btn btn-secondary">Back</a>
    <a asp-page="/Index" class="btn btn-link">Home</a>
    </p>

<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>City</th>
        <th>Registered</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Clients)
    {
        <tr>
            <td>@c.Id</td>
            <td>@c.LastName @c.FirstName</td>
            <td>@c.Email</td>
            <td>@c.PhoneNumber</td>
            <td>@c.City</td>
            <td>@c.RegistrationDate</td>
            <td>
                <a asp-page="Details" asp-route-id="@c.Id">Details</a> |
                <a asp-page="Edit" asp-route-id="@c.Id">Edit</a> |
                <a asp-page="Delete" asp-route-id="@c.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
    </table>

