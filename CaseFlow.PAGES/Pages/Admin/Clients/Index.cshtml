@page
@model CaseFlow.PAGES.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "Клієнти";
}

<h2>Клієнти</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Створити нового клієнта</a>
    <a asp-page="../Index" class="btn btn-secondary">Назад</a>
    <a asp-page="/Index" class="btn btn-link">Головна</a>
    </p>

<table class="table sortable-table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Ім'я</th>
        <th>Email</th>
        <th>Телефон</th>
        <th>Місто</th>
        <th>Зареєстровано</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Clients)
    {
        <tr>
            <td>@c.Id</td>
            <td>@c.FullName</td>
            <td>@c.Email</td>
            <td>@c.PhoneNumber</td>
            <td>@c.City</td>
            <td>@c.RegistrationDate</td>
            <td>
                <a asp-page="Details" asp-route-id="@c.Id">Деталі</a> |
                <a asp-page="Edit" asp-route-id="@c.Id">Редагувати</a> |
                <a asp-page="Delete" asp-route-id="@c.Id">Видалити</a>
            </td>
        </tr>
    }
    </tbody>
    </table>

@section Scripts {
    <script src="~/js/table-sorting.js"></script>
}

