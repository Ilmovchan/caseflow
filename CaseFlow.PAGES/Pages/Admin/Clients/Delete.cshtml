@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Clients.DeleteModel
@{
    ViewData["Title"] = "Видалити клієнта";
}

<h2>Видалити клієнта</h2>

<div class="alert alert-warning">
    Ви впевнені, що хочете видалити клієнта <strong>#@Model.Client.Id</strong> - "@Model.Client.LastName @Model.Client.FirstName"?
</div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
    <a asp-page="Details" asp-route-id="@Model.Client.Id" class="btn btn-link">Деталі</a>
    <div class="text-danger mt-2">@Model.ErrorMessage</div>
</form>

