@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Expenses.DetailsModel
@{
    ViewData["Title"] = "Expense Details";
}

<h2>Expense Details</h2>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Expense.Id</dd>
    <dt class="col-sm-2">Case ID</dt>
    <dd class="col-sm-10">@Model.Expense.CaseId</dd>
    <dt class="col-sm-2">Purpose</dt>
    <dd class="col-sm-10">@Model.Expense.Purpose</dd>
    <dt class="col-sm-2">Amount</dt>
    <dd class="col-sm-10">@Model.Expense.Amount.ToString("C")</dd>
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.Expense.DateTime</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">
        <span class="badge bg-@(Model.Expense.ApprovalStatus.ToString() == "Approved" ? "success" : Model.Expense.ApprovalStatus.ToString() == "Pending" ? "warning" : "secondary")">
            @Model.Expense.ApprovalStatus
        </span>
    </dd>
    <dt class="col-sm-2">Annotation</dt>
    <dd class="col-sm-10">@(Model.Expense.Annotation ?? "-")</dd>
</dl>

<p>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</p>
