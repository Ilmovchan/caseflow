@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Expenses.DetailsModel
@{
    ViewData["Title"] = "Деталі видатків";
}

<h2>Деталі видатків</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Expense.Id</dd>
    <dt class="col-sm-2">Пов’язана справа</dt>
    <dd class="col-sm-10">
        <a asp-page="/Admin/Cases/Details" asp-route-id="@Model.Expense.CaseId">
            @Model.Expense.CaseId
        </a>
    </dd>
    <dt class="col-sm-2">Мета</dt>
    <dd class="col-sm-10">@Model.Expense.Purpose</dd>
    <dt class="col-sm-2">Сума</dt>
    <dd class="col-sm-10">@Model.Expense.Amount.ToString("C")</dd>
    <dt class="col-sm-2">Дата</dt>
    <dd class="col-sm-10">@Model.Expense.DateTime</dd>
    <dt class="col-sm-2">Статус</dt>
    <dd class="col-sm-10">
        <span class="badge bg-@(Model.Expense.ApprovalStatus.ToString() == "Approved" ? "success" : Model.Expense.ApprovalStatus.ToString() == "Pending" ? "warning" : Model.Expense.ApprovalStatus.ToString() == "Declined" ? "danger" : "secondary")">
            @UkLabels.ApprovalStatusLabel(Model.Expense.ApprovalStatus)
        </span>
    </dd>
    <dt class="col-sm-2">Створив детектив</dt>
    <dd class="col-sm-10">
        @if (Model.Expense.CreatedByDetectiveId is int creatorId && Model.Expense.CreatedByDetective != null)
        {
            var cd = Model.Expense.CreatedByDetective;
            <a asp-page="/Admin/Detectives/Details" asp-route-id="@creatorId">#@creatorId — @cd.LastName @cd.FirstName</a>
        }
        else if (Model.Expense.CreatedByDetectiveId is int onlyId)
        {
            <a asp-page="/Admin/Detectives/Details" asp-route-id="@onlyId">#@onlyId</a>
        }
        else
        {
            <span>—</span>
        }
    </dd>
    <dt class="col-sm-2">Примітка</dt>
    <dd class="col-sm-10">@(Model.Expense.Annotation ?? "-")</dd>
</dl>

<p>
    <a asp-page-handler="ExportPdf" asp-route-id="@Model.Expense.Id" class="btn btn-outline-danger text-white">Export PDF</a>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</p>
