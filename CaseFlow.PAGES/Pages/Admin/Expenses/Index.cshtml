@page
@model CaseFlow.PAGES.Pages.Admin.Expenses.IndexModel
@{
    ViewData["Title"] = "Витрати";
}

<h2>Витрати</h2>

<p>
    <a asp-page="../Index" class="btn btn-secondary">Назад до адміністратора</a>
    <a asp-page="/Index" class="btn btn-link">Головна</a>
</p>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">Всі витрати</h6>
                <p class="card-text">@Model.AllExpenses.Count елементів</p>
                <a asp-page="All" class="btn btn-outline-primary btn-sm">Переглянути всі</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">Очікують затвердження</h6>
                <p class="card-text">@Model.PendingExpenses.Count елементів</p>
                <a asp-page="Pending" class="btn btn-outline-warning btn-sm">Переглянути очікуючі</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">За справою</h6>
                <p class="card-text">Фільтр за справою</p>
                <a asp-page="ByCase" class="btn btn-outline-info btn-sm">Переглянути за справою</a>
            </div>
        </div>
    </div>
</div>

<h3>Останні витрати</h3>
<table class="table sortable-table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Справа</th>
        <th>Призначення</th>
        <th>Сума</th>
        <th>Дата</th>
        <th>Статус</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var e in Model.AllExpenses.Take(10))
    {
        <tr>
            <td>@e.Id</td>
            <td>@e.CaseTitle</td>
            <td>@e.Purpose</td>
            <td>@e.Amount.ToString("C")</td>
            <td>@e.DateTime.ToString("yyyy-MM-dd")</td>
            <td>
                <span class="badge bg-@(e.ApprovalStatus.ToString() == "Approved" ? "success" : e.ApprovalStatus.ToString() == "Pending" ? "warning" : "secondary")">
                    @e.ApprovalStatus
                </span>
            </td>
            <td>
                <a asp-page="Details" asp-route-id="@e.Id">Деталі</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <script src="~/js/table-sorting.js"></script>
}
