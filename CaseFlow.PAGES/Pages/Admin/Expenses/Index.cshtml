@page
@model CaseFlow.PAGES.Pages.Admin.Expenses.IndexModel
@{
    ViewData["Title"] = "Витрати";
}

<div class="d-flex justify-content-between align-items-center mb-3 gap-2">
    <form method="get" class="d-flex gap-3" style="flex: 1; max-width: 400px;">
        <input type="text" name="searchTerm" class="form-control" placeholder="Пошук..." value="@Model.SearchTerm" />
        <button type="submit" class="btn btn-outline-secondary" title="Пошук">
            <i class="fas fa-search"></i>
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <a href="@Url.Page("Index")" class="btn btn-outline-secondary" title="Очистити">
                <i class="fas fa-times"></i>
            </a>
        }
    </form>
</div>

<table id="expenses-table" class="table sortable-table paginated-table">
    <thead>
    <tr>
        <th class="text-center">ID</th>
        <th class="text-center">Справа</th>
        <th class="text-center">Призначення</th>
        <th class="text-center">Сума</th>
        <th class="text-center">Дата</th>
        <th class="text-center">Статус</th>
        <th class="text-center">Дії</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var e in Model.AllExpenses)
    {
        <tr class="clickable-row" data-href="@Url.Page("Details", new { id = e.Id })">
            <td>@e.Id</td>
            <td>@e.CaseTitle</td>
            <td>@e.Purpose</td>
            <td>@e.Amount.ToString("C")</td>
            <td>@e.DateTime.ToString("yyyy-MM-dd")</td>
            <td>
                <span class="badge bg-@(e.ApprovalStatus.ToString() == "Approved" ? "success" : e.ApprovalStatus.ToString() == "Pending" ? "warning" : e.ApprovalStatus.ToString() == "Declined" ? "danger" : "secondary") approval-status" data-id="@e.Id" data-status="@e.ApprovalStatus">
                    @(e.ApprovalStatus.ToString() == "Approved" ? "Схвалено" : e.ApprovalStatus.ToString() == "Pending" ? "Очікує" : e.ApprovalStatus.ToString() == "Declined" ? "Відхилено" : "Чернетка")
                </span>
            </td>
            <td class="approval-actions">
                @if (e.ApprovalStatus.ToString() == "Pending")
                {
                    <button class="btn btn-sm btn-success btn-approve" data-id="@e.Id" data-type="expense" title="Схвалити">
                        <i class="fas fa-check"></i> Схвалити
                    </button>
                    <button class="btn btn-sm btn-danger btn-reject" data-id="@e.Id" data-type="expense" title="Відхилити">
                        <i class="fas fa-times"></i> Відхилити
                    </button>
                }
                else
                {
                    <span class="text-muted">Оброблено</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>


@if (Model.PagedExpenses.TotalPages > 1)
{
    <nav aria-label="Expenses pagination" class="mt-3">
        <ul class="pagination justify-content-center">
            @if (Model.PagedExpenses.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage - 1)@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $"&searchTerm={Uri.EscapeDataString(Model.SearchTerm)}")">Назад</a>
                </li>
            }

            @for (int i = Math.Max(1, Model.CurrentPage - 1); i <= Math.Min(Model.PagedExpenses.TotalPages, Model.CurrentPage + 1); i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?pageNumber=@i@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $"&searchTerm={Uri.EscapeDataString(Model.SearchTerm)}")">@i</a>
                </li>
            }

            @if (Model.PagedExpenses.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage + 1)@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $"&searchTerm={Uri.EscapeDataString(Model.SearchTerm)}")">Далі</a>
                </li>
            }
        </ul>
    </nav>

    <div class="text-center text-muted">
        Показано @((Model.CurrentPage - 1) * Model.PageSize + 1)-@(Math.Min(Model.CurrentPage * Model.PageSize, Model.PagedExpenses.TotalCount)) з @Model.PagedExpenses.TotalCount записів
    </div>
}

<div class="mb-5"></div>

@section Scripts {
    <script src="~/js/table-sorting.js"></script>
    <script src="~/js/table-filters.js"></script>
    <script src="~/js/table-pagination.js"></script>
    <script src="~/js/approval-system.js"></script>
}
