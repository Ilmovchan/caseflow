@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Evidence.DetailsModel
@{
    ViewData["Title"] = "Деталі доказу";
}

<h2>Деталі доказу</h2>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Evidence.Id</dd>
    <dt class="col-sm-2">Тип</dt>
    <dd class="col-sm-10">@Model.Evidence.Type</dd>
    <dt class="col-sm-2">Опис</dt>
    <dd class="col-sm-10">@Model.Evidence.Description</dd>
    <dt class="col-sm-2">Дата збору</dt>
    <dd class="col-sm-10">@Model.Evidence.CollectionDate</dd>
    <dt class="col-sm-2">Регіон</dt>
    <dd class="col-sm-10">@Model.Evidence.Region</dd>
    <dt class="col-sm-2">Примітка</dt>
    <dd class="col-sm-10">@(Model.Evidence.Annotation ?? "-")</dd>
    <dt class="col-sm-2">Мета</dt>
    <dd class="col-sm-10">@(Model.Evidence.Purpose ?? "-")</dd>
</dl>

<div class="mt-4">
    <h4 class="mb-3">Пов’язані справи</h4>
    @if (Model.ConnectedCases.Count == 0)
    {
        <div class="text-muted">Для цього доказу немає пов’язаних справ.</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th class="text-center">ID</th>
                <th>Назва</th>
                <th>Клієнт</th>
                <th>Детектив</th>
                <th>Тип справи</th>
                <th class="text-center">Початок</th>
                <th class="text-center">Термін</th>
                <th class="text-center">Закриття</th>
                <th class="text-center">Статус</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.ConnectedCases)
            {
                <tr class="clickable-row" data-href="@Url.Page("/Admin/Cases/Details", new { id = c.Id })">
                    <td class="text-center">@c.Id</td>
                    <td>@c.Title</td>
                    <td>@(c.Client != null ? $"{c.Client.LastName} {c.Client.FirstName}" : "-")</td>
                    <td>@(c.Detective != null ? $"{c.Detective.LastName} {c.Detective.FirstName}" : "-")</td>
                    <td>@(c.CaseType?.Name ?? "-")</td>
                    <td class="text-center">@c.StartDate</td>
                    <td class="text-center">@c.DeadlineDate</td>
                    <td class="text-center">@(c.CloseDate?.ToString() ?? "-")</td>
                    <td class="text-center">
                        @{
                            var isOverdue = c.Status.ToString() == "Opened" && c.DeadlineDate < DateOnly.FromDateTime(DateTime.Now);
                            var statusClass = isOverdue
                                ? "danger"
                                : c.Status.ToString() == "Closed"
                                    ? "success"
                                    : c.Status.ToString() == "Paused"
                                        ? "secondary"
                                        : "warning";
                            var statusText = isOverdue
                                ? "Протерміновано"
                                : c.Status.ToString() == "Closed"
                                    ? "Закрито"
                                    : c.Status.ToString() == "Paused"
                                        ? "Призупинено"
                                        : "Відкрито";
                        }
                        <span class="badge bg-@statusClass">@statusText</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<p>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</p>
