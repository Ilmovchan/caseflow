@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Evidence.DetailsModel
@{
    ViewData["Title"] = "Evidence Details";
}

<h2>Evidence Details</h2>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Evidence.Id</dd>
    <dt class="col-sm-2">Type</dt>
    <dd class="col-sm-10">@Model.Evidence.Type</dd>
    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Evidence.Description</dd>
    <dt class="col-sm-2">Collection Date</dt>
    <dd class="col-sm-10">@Model.Evidence.CollectionDate</dd>
    <dt class="col-sm-2">Region</dt>
    <dd class="col-sm-10">@Model.Evidence.Region</dd>
    <dt class="col-sm-2">Annotation</dt>
    <dd class="col-sm-10">@(Model.Evidence.Annotation ?? "-")</dd>
    <dt class="col-sm-2">Purpose</dt>
    <dd class="col-sm-10">@(Model.Evidence.Purpose ?? "-")</dd>
</dl>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Evidence.Id" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</p>
