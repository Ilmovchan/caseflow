@page
@model CaseFlow.PAGES.Pages.Admin.Evidence.IndexModel
@{
    ViewData["Title"] = "Evidence";
}

<h2>Evidence</h2>

<p>
    <a asp-page="../Index" class="btn btn-secondary">Back to Admin</a>
    <a asp-page="/Index" class="btn btn-link">Home</a>
</p>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">All Evidence</h6>
                <p class="card-text">@Model.AllEvidence.Count items</p>
                <a asp-page="All" class="btn btn-outline-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">Pending Approval</h6>
                <p class="card-text">@Model.PendingEvidence.Count items</p>
                <a asp-page="Pending" class="btn btn-outline-warning btn-sm">View Pending</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">By Case</h6>
                <p class="card-text">Filter by case</p>
                <a asp-page="ByCase" class="btn btn-outline-info btn-sm">View by Case</a>
            </div>
        </div>
    </div>
</div>

<h3>Recent Evidence</h3>
<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Type</th>
        <th>Description</th>
        <th>Collection Date</th>
        <th>Region</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var e in Model.AllEvidence.Take(10))
    {
        <tr>
            <td>@e.Id</td>
            <td>@e.Type</td>
            <td>@e.Description</td>
            <td>@e.CollectionDate.ToString("yyyy-MM-dd")</td>
            <td>@e.Region</td>
            <td>
                <a asp-page="Details" asp-route-id="@e.Id">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
