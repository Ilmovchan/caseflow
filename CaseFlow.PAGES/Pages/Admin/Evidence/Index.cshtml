@page
@model CaseFlow.PAGES.Pages.Admin.Evidence.IndexModel
@{
    ViewData["Title"] = "Докази";
}

<h2>Докази</h2>

<p>
    <a asp-page="../Index" class="btn btn-secondary">Назад до адміністратора</a>
    <a asp-page="/Index" class="btn btn-link">Головна</a>
</p>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">Всі докази</h6>
                <p class="card-text">@Model.AllEvidence.Count елементів</p>
                <a asp-page="All" class="btn btn-outline-primary btn-sm">Переглянути всі</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">Очікують затвердження</h6>
                <p class="card-text">@Model.PendingEvidence.Count елементів</p>
                <a asp-page="Pending" class="btn btn-outline-warning btn-sm">Переглянути очікуючі</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">За справою</h6>
                <p class="card-text">Фільтр за справою</p>
                <a asp-page="ByCase" class="btn btn-outline-info btn-sm">Переглянути за справою</a>
            </div>
        </div>
    </div>
</div>

<h3>Останні докази</h3>
<table class="table sortable-table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Тип</th>
        <th>Опис</th>
        <th>Дата збору</th>
        <th>Регіон</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var e in Model.AllEvidence.Take(10))
    {
        <tr>
            <td>@e.Id</td>
            <td>@e.Type</td>
            <td>@e.Description</td>
            <td>@e.CollectionDate.ToString("yyyy-MM-dd")</td>
            <td>@e.Region</td>
            <td>
                <a asp-page="Details" asp-route-id="@e.Id">Деталі</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <script src="~/js/table-sorting.js"></script>
}
