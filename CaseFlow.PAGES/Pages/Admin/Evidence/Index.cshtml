@page
@model CaseFlow.PAGES.Pages.Admin.Evidence.IndexModel
@{
    ViewData["Title"] = "Докази";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Докази</h2>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary filter-btn" data-table="evidence-table">
            <i class="fas fa-filter me-1"></i>Фільтр
        </button>
        <a asp-page="Create" class="btn btn-primary">Створити новий доказ</a>
    </div>
</div>

<p>
    <a asp-page="../Index" class="btn btn-secondary">Назад</a>
    <a asp-page="/Index" class="btn btn-link">Головна</a>
</p>

<table id="evidence-table" class="table sortable-table paginated-table">
    <thead>
    <tr>
        <th class="text-center">ID</th>
        <th class="text-center">Тип</th>
        <th class="text-center">Опис</th>
        <th class="text-center">Дата збору</th>
        <th class="text-center">Регіон</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var e in Model.AllEvidence)
    {
        <tr class="clickable-row" data-href="@Url.Page("Details", new { id = e.Id })">
            <td>@e.Id</td>
            <td>@e.Type</td>
            <td>@e.Description</td>
            <td>@e.CollectionDate.ToString("yyyy-MM-dd")</td>
            <td>@e.Region</td>
        </tr>
    }
    </tbody>
</table>

<!-- Server-side Pagination -->
@if (Model.PagedEvidence.TotalPages > 1)
{
    <nav aria-label="Evidence pagination" class="mt-3">
        <ul class="pagination justify-content-center">
            @if (Model.PagedEvidence.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage - 1)">Попередня</a>
                </li>
            }
            
            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.PagedEvidence.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?pageNumber=@i">@i</a>
                </li>
            }
            
            @if (Model.PagedEvidence.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="?pageNumber=@(Model.CurrentPage + 1)">Наступна</a>
                </li>
            }
        </ul>
    </nav>
    
    <div class="text-center text-muted">
        Показано @((Model.CurrentPage - 1) * Model.PageSize + 1)-@(Math.Min(Model.CurrentPage * Model.PageSize, Model.PagedEvidence.TotalCount)) з @Model.PagedEvidence.TotalCount записів
    </div>
}

<div class="mb-5"></div>

@section Scripts {
    <script src="~/js/table-sorting.js"></script>
    <script src="~/js/table-filters.js"></script>
    <script src="~/js/table-pagination.js"></script>
}
