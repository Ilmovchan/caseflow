@page
@model CaseFlow.PAGES.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Панель адміністратора";
}

<!-- Hero Section -->
<div class="hero-section text-center mb-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center justify-content-center mb-4">
                    <div class="admin-icon-wrapper">
                        <i class="fas fa-shield-alt fa-3x text-primary"></i>
                    </div>
                </div>
                <h1 class="display-4 fw-bold mb-3">Система управління</h1>
                <p class="lead text-muted">Керуйте справами, клієнтами та детективами в одному місці</p>
            </div>
        </div>
    </div>
</div>

<!-- Management Cards -->
<div class="row g-4">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 admin-card">
            <div class="card-body d-flex flex-column">
                <div class="card-icon-wrapper mb-3">
                    <i class="fas fa-folder-open fa-3x text-primary"></i>
                </div>
                <h5 class="card-title mb-3">Справи</h5>
                <p class="card-text flex-grow-1">Керуйте справами, призначайте детективів та відстежуйте статус справ.</p>
                <div class="mt-auto">
                    <a asp-page="Cases/Index" class="btn btn-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Керувати справами
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 admin-card">
            <div class="card-body d-flex flex-column">
                <div class="card-icon-wrapper mb-3">
                    <i class="fas fa-users fa-3x text-primary"></i>
                </div>
                <h5 class="card-title mb-3">Клієнти</h5>
                <p class="card-text flex-grow-1">Керуйте інформацією про клієнтів та контактними даними.</p>
                <div class="mt-auto">
                    <a asp-page="Clients/Index" class="btn btn-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Керувати клієнтами
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 admin-card">
            <div class="card-body d-flex flex-column">
                <div class="card-icon-wrapper mb-3">
                    <i class="fas fa-user-tie fa-3x text-primary"></i>
                </div>
                <h5 class="card-title mb-3">Детективи</h5>
                <p class="card-text flex-grow-1">Керуйте профілями детективів та призначеннями.</p>
                <div class="mt-auto">
                    <a asp-page="Detectives/Index" class="btn btn-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Керувати детективами
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 admin-card">
            <div class="card-body d-flex flex-column">
                <div class="card-icon-wrapper mb-3">
                    <i class="fas fa-tags fa-3x text-primary"></i>
                </div>
                <h5 class="card-title mb-3">Типи справ</h5>
                <p class="card-text flex-grow-1">Керуйте типами справ та ціноутворенням.</p>
                <div class="mt-auto">
                    <a asp-page="CaseTypes/Index" class="btn btn-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Керувати типами справ
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 admin-card">
            <div class="card-body d-flex flex-column">
                <div class="card-icon-wrapper mb-3">
                    <i class="fas fa-fingerprint fa-3x text-primary"></i>
                </div>
                <h5 class="card-title mb-3">Докази</h5>
                <p class="card-text flex-grow-1">Переглядайте та керуйте доказами.</p>
                <div class="mt-auto">
                    <a asp-page="Evidence/Index" class="btn btn-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Керувати доказами
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 admin-card">
            <div class="card-body d-flex flex-column">
                <div class="card-icon-wrapper mb-3">
                    <i class="fas fa-user-secret fa-3x text-primary"></i>
                </div>
                <h5 class="card-title mb-3">Підозрювані</h5>
                <p class="card-text flex-grow-1">Переглядайте та керуйте інформацією про підозрюваних.</p>
                <div class="mt-auto">
                    <a asp-page="Suspects/Index" class="btn btn-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Керувати підозрюваними
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 admin-card">
            <div class="card-body d-flex flex-column">
                <div class="card-icon-wrapper mb-3">
                    <i class="fas fa-dollar-sign fa-3x text-primary"></i>
                </div>
                <h5 class="card-title mb-3">Витрати</h5>
                <p class="card-text flex-grow-1">Переглядайте та затверджуйте витрати по справах.</p>
                <div class="mt-auto">
                    <a asp-page="Expenses/Index" class="btn btn-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Керувати витратами
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 admin-card">
            <div class="card-body d-flex flex-column">
                <div class="card-icon-wrapper mb-3">
                    <i class="fas fa-file-alt fa-3x text-primary"></i>
                </div>
                <h5 class="card-title mb-3">Звіти</h5>
                <p class="card-text flex-grow-1">Переглядайте та затверджуйте звіти по справах.</p>
                <div class="mt-auto">
                    <a asp-page="Reports/Index" class="btn btn-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Керувати звітами
                    </a>
                </div>
            </div>
        </div>
    </div>

