@page
@model CaseFlow.PAGES.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Панель адміністратора";
}


<div class="admin-hero-section mb-5 text-center position-relative">
    <div class="floating-bg"></div>

    <div class="admin-hero-icon mx-auto mb-4">
        <i class="fas fa-shield-alt"></i>
    </div>

    <h1 class="admin-hero-title fw-bold mb-3">CaseFlow Admin Panel</h1>
    <p class="admin-hero-subtitle mb-0">Система управління детективним агентством</p>
</div>



<div class="admin-dashboard">

    
    <div class="dashboard-section mb-5">
        <h2 class="section-title mb-4">Основне управління</h2>
        <div class="row g-3">
            <div class="col-lg-6 col-md-6">
                <div class="admin-panel-card">
                    <div class="card-icon"><i class="fas fa-users"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Клієнти</h3>
                        <p class="card-description">Управління інформацією про клієнтів</p>
                        <a asp-page="Clients/Index" class="card-action">
                            <span>Перейти до клієнтів</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="admin-panel-card">
                    <div class="card-icon"><i class="fas fa-user-tie"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Детективи</h3>
                        <p class="card-description">Керування профілями детективів</p>
                        <a asp-page="Detectives/Index" class="card-action">
                            <span>Перейти до детективів</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    <div class="dashboard-section mb-5">
        <h2 class="section-title mb-4">Робота з матеріалами справ</h2>
        <div class="row g-3">
            <div class="col-lg-4 col-md-6">
                <div class="admin-panel-card">
                    <div class="card-icon"><i class="fas fa-folder-open"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Справи</h3>
                        <p class="card-description">Керування справами та призначення детективів</p>
                        <a asp-page="Cases/Index" class="card-action">
                            <span>Перейти до справ</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="admin-panel-card position-relative">
                    @if (Model.PendingEvidenceCount > 0)
                    {
                        <span class="badge-notification">@Model.PendingEvidenceCount</span>
                    }
                    <div class="card-icon"><i class="fas fa-fingerprint"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Докази</h3>
                        <p class="card-description">Перегляд та керування доказами</p>
                        <a asp-page="Evidence/Index" class="card-action">
                            <span>Керувати доказами</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="admin-panel-card position-relative">
                    @if (Model.PendingSuspectsCount > 0)
                    {
                        <span class="badge-notification">@Model.PendingSuspectsCount</span>
                    }
                    <div class="card-icon"><i class="fas fa-user-secret"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Підозрювані</h3>
                        <p class="card-description">Інформація про підозрюваних</p>
                        <a asp-page="Suspects/Index" class="card-action">
                            <span>Переглянути</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="admin-panel-card position-relative">
                    @if (Model.PendingExpensesCount > 0)
                    {
                        <span class="badge-notification">@Model.PendingExpensesCount</span>
                    }
                    <div class="card-icon"><i class="fas fa-dollar-sign"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Витрати</h3>
                        <p class="card-description">Затвердження витрат по справах</p>
                        <a asp-page="Expenses/Index" class="card-action">
                            <span>Керувати</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="admin-panel-card position-relative">
                    @if (Model.PendingReportsCount > 0)
                    {
                        <span class="badge-notification">@Model.PendingReportsCount</span>
                    }
                    <div class="card-icon"><i class="fas fa-file-alt"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Звіти</h3>
                        <p class="card-description">Перегляд та затвердження звітів по справах</p>
                        <a asp-page="Reports/Index" class="card-action">
                            <span>Перейти до звітів</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    <div class="dashboard-section">
        <h2 class="section-title mb-4">Налаштування системи</h2>
        <div class="row justify-content-start">
            <div class="col-lg-4 col-md-6">
                <div class="admin-panel-card compact">
                    <div class="card-icon"><i class="fas fa-tags"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Типи справ</h3>
                        <p class="card-description">Налаштування типів справ і тарифів</p>
                        <a asp-page="CaseTypes/Index" class="card-action">
                            <span>Керувати</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-section mt-5 mb-0">
        <h2 class="section-title mb-4">Спеціальні виборки</h2>
        <div class="row g-3 justify-content-start">
            <div class="col-lg-6 col-md-6">
                <div class="admin-panel-card compact">
                    <div class="card-icon"><i class="fas fa-database"></i></div>
                    <div class="card-content">
                        <h3 class="card-title">Звіти та аналітика</h3>
                        <a asp-page="SpecialQueries/Index" class="card-action">
                            <span>Відкрити</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

