@page
@model CaseFlow.PAGES.Pages.Admin.Cases.IndexModel
@{
    ViewData["Title"] = "Справи";
}

<div class="d-flex justify-content-between align-items-center mb-3 gap-2">
    <form method="get" class="d-flex gap-3" style="flex: 1; max-width: 400px;">
        <input type="text" name="searchTerm" class="form-control" placeholder="Пошук..." value="@Model.SearchTerm" />
        <button type="submit" class="btn btn-outline-secondary" title="Пошук">
            <i class="fas fa-search"></i>
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <a href="@Url.Page("Index")" class="btn btn-outline-secondary" title="Очистити">
                <i class="fas fa-times"></i>
            </a>
        }
    </form>
    <a asp-page="Create" class="btn btn-primary">Створити нову справу</a>
</div>

<table id="cases-table" class="table sortable-table paginated-table">
    <thead>
    <tr>
        <th class="text-center">ID</th>
        <th class="text-center">Назва</th>
        <th class="text-center">Клієнт</th>
        <th class="text-center">Детектив</th>
        <th class="text-center">Тип справи</th>
        <th class="text-center">Початок</th>
        <th class="text-center">Термін</th>
        <th class="text-center">Закриття</th>
        <th class="text-center">Статус</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Cases)
    {
        <tr class="clickable-row" data-href="@Url.Page("Details", new { id = c.Id })">
            <td>@c.Id</td>
            <td>@c.Title</td>
            <td>@c.ClientFullName</td>
            <td>@(c.DetectiveFullName ?? "-")</td>
            <td>@c.CaseTypeName</td>
            <td>@c.StartDate</td>
            <td>@c.DeadlineDate</td>
            <td>@(c.CloseDate?.ToString() ?? "-")</td>
            <td class="text-center">
                @{
                    var isOverdue = c.Status.ToString() == "Opened" && c.DeadlineDate < DateOnly.FromDateTime(DateTime.Now);
                    var statusClass = isOverdue
                        ? "danger"
                        : c.Status.ToString() == "Closed"
                            ? "success"
                            : c.Status.ToString() == "Paused"
                                ? "secondary"
                                : "warning";
                    var statusText = isOverdue
                        ? "Протерміновано"
                        : c.Status.ToString() == "Closed"
                            ? "Закрито"
                            : c.Status.ToString() == "Paused"
                                ? "Призупинено"
                                : "Відкрито";
                }
                <span class="badge bg-@statusClass">@statusText</span>
            </td>
        </tr>
    }
    </tbody>
    </table>

    
    @if (Model.PagedCases.TotalPages > 1)
    {
        <nav aria-label="Cases pagination" class="mt-3">
            <ul class="pagination justify-content-center">
                @if (Model.PagedCases.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="?pageNumber=@(Model.CurrentPage - 1)@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $"&searchTerm={Uri.EscapeDataString(Model.SearchTerm)}")">Назад</a>
                    </li>
                }

                @for (int i = Math.Max(1, Model.CurrentPage - 1); i <= Math.Min(Model.PagedCases.TotalPages, Model.CurrentPage + 1); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?pageNumber=@i@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $"&searchTerm={Uri.EscapeDataString(Model.SearchTerm)}")">@i</a>
                    </li>
                }

                @if (Model.PagedCases.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="?pageNumber=@(Model.CurrentPage + 1)@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $"&searchTerm={Uri.EscapeDataString(Model.SearchTerm)}")">Далі</a>
                    </li>
                }
            </ul>
        </nav>

        <div class="text-center text-muted">
            Показано @((Model.CurrentPage - 1) * Model.PageSize + 1)-@(Math.Min(Model.CurrentPage * Model.PageSize, Model.PagedCases.TotalCount)) з @Model.PagedCases.TotalCount записів
        </div>
    }

<div class="mb-5"></div>

@section Scripts {
    <script src="~/js/table-sorting.js"></script>
    <script src="~/js/table-filters.js"></script>
    <script src="~/js/table-pagination.js"></script>
}

