@page
@model CaseFlow.PAGES.Pages.Admin.Cases.IndexModel
@{
    ViewData["Title"] = "Справи";
}

<h2>Справи</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Створити нову справу</a>
    <a asp-page="../Index" class="btn btn-secondary">Назад</a>
    <a asp-page="/Index" class="btn btn-link">Головна</a>
    </p>

<table class="table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Назва</th>
        <th>Статус</th>
        <th>Клієнт</th>
        <th>Детектив</th>
        <th>Тип справи</th>
        <th>Початок</th>
        <th>Термін</th>
        <th>Закриття</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Cases)
    {
        <tr>
            <td>@c.Id</td>
            <td>@c.Title</td>
            <td>@c.Status</td>
            <td>@c.ClientId</td>
            <td>@(c.DetectiveId?.ToString() ?? "-")</td>
            <td>@c.CaseTypeId</td>
            <td>@c.StartDate</td>
            <td>@c.DeadlineDate</td>
            <td>@(c.CloseDate?.ToString() ?? "-")</td>
            <td>
                <a asp-page="Details" asp-route-id="@c.Id">Деталі</a> |
                <a asp-page="Edit" asp-route-id="@c.Id">Редагувати</a> |
                <a asp-page="Delete" asp-route-id="@c.Id">Видалити</a>
            </td>
        </tr>
    }
    </tbody>
    </table>

