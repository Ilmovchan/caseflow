@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Cases.EditModel
@{
    ViewData["Title"] = "Редагувати справу";
}

<h2>Редагувати справу</h2>

<form method="post" id="editForm">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label">Назва</label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label">Опис</label>
        <textarea asp-for="Input.Description" class="form-control"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ClientId" class="form-label">Клієнт</label>
        <select asp-for="Input.ClientId" asp-items="Model.ClientOptions" class="form-select" required>
            <option value="">-- Оберіть клієнта --</option>
        </select>
        <span asp-validation-for="Input.ClientId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.DetectiveId" class="form-label">Детектив</label>
        <select asp-for="Input.DetectiveId" asp-items="Model.DetectiveOptions" class="form-select">
            <option value="">-- Оберіть детектива (необов'язково) --</option>
        </select>
        <span asp-validation-for="Input.DetectiveId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.CaseTypeId" class="form-label">Тип справи</label>
        <select asp-for="Input.CaseTypeId" asp-items="Model.CaseTypeOptions" class="form-select" required>
            <option value="">-- Оберіть тип справи --</option>
        </select>
        <span asp-validation-for="Input.CaseTypeId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.DeadlineDate" class="form-label">Термін виконання</label>
        <input asp-for="Input.DeadlineDate" class="form-control" type="date" />
        <span asp-validation-for="Input.DeadlineDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Status" class="form-label">Статус</label>
        <select asp-for="Input.Status" class="form-select" asp-items="Model.StatusOptions"></select>
        <span asp-validation-for="Input.Status" class="text-danger"></span>
    </div>
</form>

<div class="mt-3">
    <button type="submit" form="editForm" class="btn btn-primary">Зберегти</button>
    <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
    @if (Model.Case?.CloseDate == null)
    {
        <form method="post" asp-page-handler="CloseCase" style="display: inline;" onsubmit="return confirm('Ви впевнені, що хочете закрити цю справу?');">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-warning">Закрити справу</button>
        </form>
    }
</div>

<partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />

