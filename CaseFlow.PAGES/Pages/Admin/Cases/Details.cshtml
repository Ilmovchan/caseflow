@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Cases.DetailsModel
@{
    ViewData["Title"] = "Деталі справи";
}

<h2>Деталі справи</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Case.Id</dd>
        <dt class="col-sm-2">Назва</dt>
        <dd class="col-sm-10">@Model.Case.Title</dd>
        <dt class="col-sm-2">Статус</dt>
        <dd class="col-sm-10">@UkLabels.CaseStatusLabel(Model.Case.Status)</dd>
        <dt class="col-sm-2">Клієнт</dt>
        <dd class="col-sm-10">
            <a asp-page="/Admin/Clients/Details" asp-route-id="@Model.Case.ClientId">#@Model.Case.ClientId — @(Model.Case.Client != null ? $"{Model.Case.Client.LastName} {Model.Case.Client.FirstName}" : "")</a>
        </dd>
        <dt class="col-sm-2">Детектив</dt>
        <dd class="col-sm-10">
            @if (Model.Case.DetectiveId is int detId)
            {
                <a asp-page="/Admin/Detectives/Details" asp-route-id="@detId">#@detId — @(Model.Case.Detective != null ? $"{Model.Case.Detective.LastName} {Model.Case.Detective.FirstName}" : "")</a>
            }
            else
            {
                <span>—</span>
            }
        </dd>
        <dt class="col-sm-2">Тип справи</dt>
        <dd class="col-sm-10">
            <a asp-page="/Admin/CaseTypes/Details" asp-route-id="@Model.Case.CaseTypeId">#@Model.Case.CaseTypeId — @(Model.Case.CaseType?.Name ?? "")</a>
        </dd>
        <dt class="col-sm-2">Початок</dt>
        <dd class="col-sm-10">@Model.Case.StartDate</dd>
        <dt class="col-sm-2">Термін</dt>
        <dd class="col-sm-10">@Model.Case.DeadlineDate</dd>
        <dt class="col-sm-2">Закриття</dt>
        <dd class="col-sm-10">@(Model.Case.CloseDate?.ToString() ?? "-")</dd>
        <dt class="col-sm-2">Опис</dt>
        <dd class="col-sm-10">@Model.Case.Description</dd>
    </dl>
</div>

<div class="mt-4">
    <h4 class="mb-3">Пов’язані докази</h4>
    @if (Model.Evidences.Count == 0)
    {
        <div class="text-muted">Немає пов’язаних доказів.</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th class="text-center">ID</th>
                <th>Тип</th>
                <th>Опис</th>
                <th class="text-center">Дата</th>
                <th>Регіон</th>
                <th class="text-center">Статус</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Evidences.OrderBy(x => x.Id))
            {
                var st = e.ApprovalStatus.ToString();
                var color = st == "Approved" ? "success" : st == "Pending" ? "warning" : st == "Declined" ? "danger" : "secondary";
                var text = st == "Approved" ? "Схвалено" : st == "Pending" ? "Очікує" : st == "Declined" ? "Відхилено" : "Чернетка";
                <tr class="clickable-row" data-href="@Url.Page("/Admin/Evidence/Details", new { id = e.Id })">
                    <td class="text-center">@e.Id</td>
                    <td>@e.Type</td>
                    <td>@e.Description</td>
                    <td class="text-center">@e.CollectionDate.ToString("yyyy-MM-dd")</td>
                    <td>@e.Region</td>
                    <td class="text-center">
                        <span class="badge bg-@color">@text</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="mt-4">
    <h4 class="mb-3">Пов’язані підозрювані</h4>
    @if (Model.Suspects.Count == 0)
    {
        <div class="text-muted">Немає пов’язаних підозрюваних.</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th class="text-center">ID</th>
                <th>ПІБ</th>
                <th>Псевдонім</th>
                <th>Телефон</th>
                <th>Місто</th>
                <th class="text-center">Статус</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Suspects.OrderBy(x => x.Id))
            {
                var st = s.ApprovalStatus.ToString();
                var color = st == "Approved" ? "success" : st == "Pending" ? "warning" : st == "Declined" ? "danger" : "secondary";
                var text = st == "Approved" ? "Схвалено" : st == "Pending" ? "Очікує" : st == "Declined" ? "Відхилено" : "Чернетка";
                <tr class="clickable-row" data-href="@Url.Page("/Admin/Suspects/Details", new { id = s.Id })">
                    <td class="text-center">@s.Id</td>
                    <td>@($"{s.LastName} {s.FirstName} {s.FatherName}".Trim())</td>
                    <td>@(s.Nickname ?? "-")</td>
                    <td>@(s.PhoneNumber ?? "-")</td>
                    <td>@(s.City ?? "-")</td>
                    <td class="text-center">
                        <span class="badge bg-@color">@text</span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="mt-4">
    <h4 class="mb-3">Пов’язані звіти</h4>
    @if (Model.Reports.Count == 0)
    {
        <div class="text-muted">Немає пов’язаних звітів.</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th class="text-center">ID</th>
                <th class="text-center">Дата</th>
                <th>Резюме</th>
                <th class="text-center">Статус</th>
                <th class="text-center">PDF</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Reports.OrderByDescending(x => x.ReportDate))
            {
                var st = r.ApprovalStatus.ToString();
                var color = st == "Approved" ? "success" : st == "Pending" ? "warning" : st == "Declined" ? "danger" : "secondary";
                var text = st == "Approved" ? "Схвалено" : st == "Pending" ? "Очікує" : st == "Declined" ? "Відхилено" : "Чернетка";
                <tr class="clickable-row" data-href="@Url.Page("/Admin/Reports/Details", new { id = r.Id })">
                    <td class="text-center">@r.Id</td>
                    <td class="text-center">@r.ReportDate.ToString("yyyy-MM-dd")</td>
                    <td>@r.Summary</td>
                    <td class="text-center">
                        <span class="badge bg-@color">@text</span>
                    </td>
                    <td class="text-center">
                        <a asp-page="/Admin/Reports/Details" asp-page-handler="ExportPdf" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger" title="PDF"><i class="fas fa-file-pdf"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="mt-4">
    <h4 class="mb-3">Пов’язані видатки</h4>
    @if (Model.Expenses.Count == 0)
    {
        <div class="text-muted">Немає пов’язаних видатків.</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
            <tr>
                <th class="text-center">ID</th>
                <th class="text-center">Дата</th>
                <th>Мета</th>
                <th class="text-end">Сума</th>
                <th class="text-center">Статус</th>
                <th class="text-center">PDF</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var ex in Model.Expenses.OrderByDescending(x => x.DateTime))
            {
                var st = ex.ApprovalStatus.ToString();
                var color = st == "Approved" ? "success" : st == "Pending" ? "warning" : st == "Declined" ? "danger" : "secondary";
                var text = st == "Approved" ? "Схвалено" : st == "Pending" ? "Очікує" : st == "Declined" ? "Відхилено" : "Чернетка";
                <tr class="clickable-row" data-href="@Url.Page("/Admin/Expenses/Details", new { id = ex.Id })">
                    <td class="text-center">@ex.Id</td>
                    <td class="text-center">@ex.DateTime.ToString("yyyy-MM-dd")</td>
                    <td>@ex.Purpose</td>
                    <td class="text-end">@ex.Amount.ToString("C")</td>
                    <td class="text-center">
                        <span class="badge bg-@color">@text</span>
                    </td>
                    <td class="text-center">
                        <a asp-page="/Admin/Expenses/Details" asp-page-handler="ExportPdf" asp-route-id="@ex.Id" class="btn btn-sm btn-outline-danger" title="PDF"><i class="fas fa-file-pdf"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Case.Id" class="btn btn-primary">Редагувати</a>
    <a asp-page="Index" class="btn btn-secondary">Назад</a>
</p>

