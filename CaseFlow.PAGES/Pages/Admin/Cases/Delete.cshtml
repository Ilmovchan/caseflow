@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Cases.DeleteModel
@{
    ViewData["Title"] = "Видалити справу";
}

<h2>Видалити справу</h2>

<div class="alert alert-warning">
    Ви впевнені, що хочете видалити справу <strong>#@Model.Case.Id</strong> - "@Model.Case.Title"?
</div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a asp-page="Index" class="btn btn-secondary">Скасувати</a>
    <a asp-page="Details" asp-route-id="@Model.Case.Id" class="btn btn-link">Деталі</a>
    <div class="text-danger mt-2">@Model.ErrorMessage</div>
</form>

