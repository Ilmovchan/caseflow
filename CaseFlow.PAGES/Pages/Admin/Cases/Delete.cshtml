@page "{id:int}"
@model CaseFlow.PAGES.Pages.Admin.Cases.DeleteModel
@{
    ViewData["Title"] = "Delete Case";
}

<h2>Delete Case</h2>

<div class="alert alert-warning">
    Are you sure you want to delete case <strong>#@Model.Case.Id</strong> - "@Model.Case.Title"?
</div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    <a asp-page="Details" asp-route-id="@Model.Case.Id" class="btn btn-link">Details</a>
    <div class="text-danger mt-2">@Model.ErrorMessage</div>
    </form>

